<Window x:Class="VideoAutoWpf.Views.SocialPublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:VideoAutoWpf.ViewModels"
        mc:Ignorable="d"
        Title="Bộ Công Cụ Đăng Bài Mạng Xã Hội (TikTok • Shorts • Reels)" 
        Height="730" Width="820"
        MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}">

    <Window.Resources>
        <!-- Gradient Hero Button Style -->
        <Style x:Key="HeroCopyButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#89b4fa" Offset="0"/>
                        <GradientStop Color="#cba6f7" Offset="0.5"/>
                        <GradientStop Color="#b4befe" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#11111b"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HBtnBd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#89b4fa"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HBtnBd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HBtnBd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickCopyBtn" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Hero 1-Click Copy -->
            <RowDefinition Height="Auto" />
            <!-- 2: Main Fields ScrollViewer -->
            <RowDefinition Height="*" />
            <!-- 3: Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📱" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="BỘ NỘI DUNG ĐĂNG BÀI MẠNG XÃ HỘI" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                        <Border Background="#2a2542" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TikTok • Shorts • Reels • FB" FontSize="10" FontWeight="Bold" Foreground="#cba6f7"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Thông tin đã được chuẩn hóa &amp; tối ưu click. Bạn có thể chỉnh sửa và sao chép chỉ bằng 1 cú nhấp chuột." 
                               FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="32,3,0,0"/>
                </StackPanel>

                <!-- Feedback Toast -->
                <Border Grid.Column="1" Background="#1e3a2f" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="6"
                        Padding="10,5" VerticalAlignment="Center"
                        Visibility="{Binding CopyFeedbackMessage, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding CopyFeedbackMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                </Border>
            </Grid>
        </Border>

        <!-- HERO 1-CLICK ACTION CARD -->
        <Border Grid.Row="1" Background="#1f213a" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="#3f4268" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="⚡ SAO CHÉP NHANH TOÀN BỘ (TIỆN LỢI NHẤT)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentYellow}"/>
                    <TextBlock Text="Ghép sẵn: [Tiêu đề cuốn hút] + [Mô tả video] + [Lời kêu gọi bấm Follow] + [Bộ Hashtags]. Dán 1 chạm là xong bài đăng hoàn chỉnh!"
                               FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding CopyFullCaptionCommand}"
                        Style="{StaticResource HeroCopyButton}" Height="46" Padding="20,0"
                        ToolTip="Sao chép toàn bộ nội dung bài đăng vào Clipboard">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SAO CHÉP TOÀN BỘ BÀI ĐĂNG" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- MAIN FIELDS SCROLLVIEWER -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel Orientation="Vertical">

                <!-- 1. TIÊU ĐỀ VIDEO -->
                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📌 Tiêu Đề Video (Hook Title)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text=" • Chuẩn SEO, giật gân, cuốn hút người xem" FontSize="10.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📋 Copy Tiêu Đề" Command="{Binding CopyPublishTitleCommand}"
                                    Style="{StaticResource QuickCopyBtn}"/>
                        </Grid>
                        <TextBox Text="{Binding CurrentPublishInfo.Title, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" FontWeight="SemiBold"
                                 Background="#161726" Foreground="{StaticResource AccentYellow}" BorderBrush="#313244"
                                 Padding="8,6" VerticalContentAlignment="Center">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- 2. HASHTAGS -->
                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏷️ Bộ Thẻ Hashtags (#)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text=" • Tối ưu phân phối xu hướng TikTok, Reels, Shorts" FontSize="10.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📋 Copy Hashtags" Command="{Binding CopyPublishHashtagsCommand}"
                                    Style="{StaticResource QuickCopyBtn}"/>
                        </Grid>
                        <TextBox Text="{Binding CurrentPublishInfo.Hashtags, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="#161726" Foreground="{StaticResource AccentCyan}" BorderBrush="#313244"
                                 Padding="8,6" MinHeight="36">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- 3. MÔ TẢ & LỜI DẪN (CAPTION) -->
                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📝 Nội Dung Mô Tả &amp; Kêu Gọi Tương Tác (Caption / CTA)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text=" • Tóm tắt câu chuyện &amp; kích thích bình luận" FontSize="10.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📋 Copy Mô Tả" Command="{Binding CopyPublishDescriptionCommand}"
                                    Style="{StaticResource QuickCopyBtn}"/>
                        </Grid>
                        <TextBox Text="{Binding CurrentPublishInfo.Description, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="#161726" Foreground="{StaticResource TextPrimary}" BorderBrush="#313244"
                                 Padding="8,6" MinHeight="75">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- 4. GỢI Ý TIÊU ĐỀ THAY THẾ (A/B TESTING) -->
                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💡 Gợi Ý Tiêu Đề Phụ (A/B Testing)" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Các biến thể tiêu đề kích thích trí tò mò khác mà bạn có thể đổi để thử nghiệm độ viral:" FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CurrentPublishInfo.AlternativeTitles, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11.5" TextWrapping="Wrap" AcceptsReturn="True"
                                 Background="#161726" Foreground="{StaticResource TextSecondary}" BorderBrush="#313244"
                                 Padding="8,6" MinHeight="45">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- 5. XEM TRƯỚC BÀI ĐĂNG HOÀN CHỈNH -->
                <Expander Header="👁️ Xem trước toàn bộ nội dung sẽ dán lên mạng xã hội" Foreground="{StaticResource TextSecondary}" FontSize="12">
                    <Border Background="#12131f" CornerRadius="6" Padding="12" Margin="0,6,0,0" BorderBrush="#2b2d42" BorderThickness="1">
                        <TextBlock Text="{Binding CurrentPublishInfo.FullCaption}"
                                   Foreground="#d0d5e8" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"/>
                    </Border>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER ACTIONS -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" CornerRadius="10" Padding="12,10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left actions: AI Regen + Open TXT + Open Folder -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút AI Tạo Lại Metadata -->
                    <Button Command="{Binding RegenerateSocialMetadataCommand}"
                            IsEnabled="{Binding IsGeneratingPublishInfo, Converter={StaticResource InverseBoolConverter}}"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                            Background="#2d224e" BorderBrush="#6c5ce7" BorderThickness="1" Foreground="#cba6f7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding IsGeneratingPublishInfo, Converter={x:Null}, FallbackValue='AI Tạo Lại Metadata'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Nút Mở File TXT đã lưu -->
                    <Button Content="📂 Mở File .TXT (Notepad)" Command="{Binding OpenPublishTxtFileCommand}"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                            ToolTip="Mở file DANG_BAI_METADATA.txt được tạo trong thư mục video"/>

                    <!-- Nút Mở Thư Mục Project -->
                    <Button Content="📁 Mở Thư Mục Video" Command="{Binding OpenOutputDirCommand}"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                </StackPanel>

                <!-- Right action: Đóng -->
                <Button Grid.Column="1" Content="Đóng" Click="CloseButton_Click"
                        Padding="16,6" MinWidth="80" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
