<Window x:Class="VideoAutoWpf.Views.YouTubeAnalyticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:VideoAutoWpf.ViewModels"
        mc:Ignorable="d"
        Title="YouTube Analytics — Phân Tích Kênh &amp; Video YouTube" 
        Height="800" Width="1200"
        MinHeight="650" MinWidth="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        d:DataContext="{d:DesignInstance Type=viewmodels:YouTubeAnalyticsViewModel}">

    <Window.Resources>
        <!-- YouTube Red Accent -->
        <SolidColorBrush x:Key="YtRed" Color="#FF0000"/>
        <SolidColorBrush x:Key="YtRedDark" Color="#CC0000"/>
        <SolidColorBrush x:Key="YtBgCard" Color="#1a1a2e"/>
        <SolidColorBrush x:Key="YtBgSection" Color="#16162a"/>
        <SolidColorBrush x:Key="YtAccentPurple" Color="#cba6f7"/>
        <SolidColorBrush x:Key="YtAccentTeal" Color="#94e2d5"/>
        <SolidColorBrush x:Key="YtAccentPink" Color="#f5c2e7"/>
        <SolidColorBrush x:Key="YtAccentOrange" Color="#fab387"/>

        <!-- Tab Button Style -->
        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="14,8" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26273b"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Stat Card Border Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#1a1a2e"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- YouTube-themed Primary Button -->
        <Style x:Key="YtBtn" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#FF0000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC0000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#990000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search TextBox Style -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#161726"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Tag Pill Button Style -->
        <Style x:Key="TagPillBtn" TargetType="Button">
            <Setter Property="Background" Value="#221e3c"/>
            <Setter Property="Foreground" Value="#cba6f7"/>
            <Setter Property="BorderBrush" Value="#44396b"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3a2f64"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sort Option RadioButton Style -->
        <Style x:Key="SortRadioBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="#1a192e"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="#322d4f"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#322552"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8964d6"/>
                                <Setter Property="Foreground" Value="#cba6f7"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#292042"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Tab Selector -->
            <RowDefinition Height="Auto" />
            <!-- 2: Content Area -->
            <RowDefinition Height="*" />
            <!-- 3: Footer / Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▶" FontSize="24" Foreground="{StaticResource YtRed}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="YOUTUBE ANALYTICS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                        <Border Background="#2a1625" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="YouTube Data API v3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource YtAccentPink}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Phân tích kênh • Nghiên cứu đối thủ • Tìm video trending • Phân tích từ khóa SEO" 
                               FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="34,2,0,0"/>
                </StackPanel>
                <!-- Error Banner -->
                <Border Grid.Column="1" Background="#2a1520" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"
                        ToolTip="{Binding ErrorMessage}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentRed}" MaxWidth="550" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ TAB SELECTOR & GEMINI KEY CONFIG ═══════════ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <!-- Tab Selector -->
            <Border Padding="8,6" Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="Tab0" Style="{StaticResource TabBtn}" Content="📊 Phân Tích Kênh" IsChecked="True" Checked="Tab_Checked" Tag="0" GroupName="YtAnalyticsTabs"/>
                        <RadioButton x:Name="TabTopic" Style="{StaticResource TabBtn}" Content="🏆 Top Kênh Theo Chủ Đề" Checked="Tab_Checked" Tag="1" GroupName="YtAnalyticsTabs"/>
                        <RadioButton x:Name="Tab1" Style="{StaticResource TabBtn}" Content="🎬 Phân Tích Video" Checked="Tab_Checked" Tag="2" GroupName="YtAnalyticsTabs"/>
                        <RadioButton x:Name="Tab2" Style="{StaticResource TabBtn}" Content="🆚 So Sánh Đối Thủ" Checked="Tab_Checked" Tag="3" GroupName="YtAnalyticsTabs"/>
                        <RadioButton x:Name="Tab3" Style="{StaticResource TabBtn}" Content="🔥 Trending &amp; Từ Khóa" Checked="Tab_Checked" Tag="4" GroupName="YtAnalyticsTabs"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding ToggleApiKeyConfigCommand}" Padding="10,5" Background="#261e38" BorderBrush="#724cb8" BorderThickness="1" Foreground="#cba6f7"
                            ToolTip="Cấu hình Gemini API Key miễn phí (Google AI Studio)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔑" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="Cấu Hình Gemini Key" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Gemini API Key Config Panel (Free alternative to Google Cloud Vertex AI) -->
            <Border Background="#201a38" CornerRadius="10" Padding="14,10" Margin="0,8,0,0" BorderBrush="#724cb8" BorderThickness="1.5"
                    Visibility="{Binding ShowApiKeyConfig, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock Text="🔑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cấu Hình Gemini API Key Miễn Phí (Google AI Studio)" FontSize="12" FontWeight="Bold" Foreground="#cba6f7" VerticalAlignment="Center"/>
                        <TextBlock Text="— Hoàn toàn MIỄN PHÍ, không cần thẻ Visa / Billing!" FontSize="11" Foreground="{StaticResource AccentGreen}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource SearchBox}" Margin="0,0,8,0" Tag="Dán Gemini API Key (bắt đầu bằng AIzaSy...)..."/>
                        <Button Grid.Column="1" Command="{Binding SaveGeminiApiKeyCommand}" Content="💾 Lưu Key" Padding="14,6" Margin="0,0,8,0"
                                Background="#724cb8" Foreground="White" FontWeight="Bold"/>
                        <Button Grid.Column="2" Command="{Binding OpenAiStudioKeyPageCommand}" Content="🌐 Lấy Key Miễn Phí (10s)" Padding="12,6" FontSize="11"
                                ToolTip="Mở Google AI Studio để lấy Gemini API Key miễn phí ngay lập tức"/>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ═══════════ CONTENT AREA ═══════════ -->
        <Grid Grid.Row="2">
            <!-- ═══ TAB 0: PHÂN TÍCH KÊNH ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ElementName=Tab0, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="0,0,0,10">
                    <!-- Search Bar -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding ChannelInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                                     x:Name="ChannelSearchBox"
                                     KeyDown="ChannelSearchBox_KeyDown"
                                     Tag="Nhập URL kênh, @handle hoặc tên kênh YouTube..." Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Command="{Binding AnalyzeChannelCommand}" Style="{StaticResource YtBtn}" Padding="18,8"
                                    IsEnabled="{Binding IsLoadingChannel, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phân Tích Kênh" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Channel Result -->
                    <StackPanel Visibility="{Binding HasChannelResult, Converter={StaticResource BoolToVisConverter}}">
                        <!-- Channel Overview Cards -->
                        <Border Background="#141427" CornerRadius="12" Padding="18" BorderBrush="#2a2a45" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Channel Avatar -->
                                <Border CornerRadius="35" Width="70" Height="70" Margin="0,0,16,0" BorderBrush="{StaticResource YtRed}" BorderThickness="2">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding ChannelInfo.ThumbnailUrl}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <!-- Channel Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ChannelInfo.Title}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <Border Background="#2a1625" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChannelInfo.CustomUrl}" FontSize="10" Foreground="{StaticResource YtAccentPink}"/>
                                        </Border>
                                        <Border Background="#1a2520" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChannelInfo.Country}" FontSize="10" Foreground="{StaticResource AccentGreen}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ChannelInfo.Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" 
                                               TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ChannelInfo.ChannelAge, StringFormat='Hoạt động: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Stats Grid (4 cards) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Subscribers -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="👥 Subscribers" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ChannelInfo.SubscriberDisplay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource YtRed}"/>
                                </StackPanel>
                            </Border>
                            <!-- Total Views -->
                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="👁️ Tổng Views" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ChannelInfo.ViewCountDisplay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                </StackPanel>
                            </Border>
                            <!-- Total Videos -->
                            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="🎬 Tổng Video" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ChannelInfo.VideoCountDisplay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                </StackPanel>
                            </Border>
                            <!-- Avg Views/Video -->
                            <Border Grid.Column="6" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="📈 TB View/Video" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ChannelInfo.AvgViewsPerVideoDisplay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource YtAccentOrange}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 🧠 AI BLUEPRINT: BÓC TÁCH CÔNG THỨC & HOOK ĐỐI THỦ -->
                        <Border Background="#1c1630" CornerRadius="12" Padding="16" BorderBrush="#724cb8" BorderThickness="1.5" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🧠" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="GEMINI AI: BÓC TÁCH CÔNG THỨC TIÊU ĐỀ &amp; RETENTION HOOK" FontSize="14" FontWeight="Bold" Foreground="#cba6f7" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="AI tự động quét toàn bộ Top video của kênh để giải mã công thức đặt tiêu đề, kỹ thuật hook giữ chân 0-15s đầu và gợi ý ý tưởng tương tự." 
                                                   FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="26,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding AnalyzeChannelAiCommand}" 
                                            Background="#724cb8" Foreground="White" FontWeight="Bold" Padding="16,8" Cursor="Hand"
                                            IsEnabled="{Binding IsLoadingAiAnalysis, Converter={StaticResource InverseBoolConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✨" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Bóc Tách Bằng AI" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- AI Result Content -->
                                <StackPanel Visibility="{Binding HasChannelAiAnalysis, Converter={StaticResource BoolToVisConverter}}" Margin="0,14,0,0">
                                    <Border Height="1" Background="#382d5a" Margin="0,0,0,14"/>

                                    <!-- Strategy Summary & Audience -->
                                    <Border Background="#141124" CornerRadius="8" Padding="14" Margin="0,0,0,12" BorderBrush="#382d5a" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="🎯 Chiến Lược Thành Công Cốt Lõi" FontSize="13" FontWeight="Bold" Foreground="#f5c2e7" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding ChannelAiAnalysis.Summary}" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding ChannelAiAnalysis.CoreAudience, StringFormat='👥 Đối tượng khán giả mục tiêu: {0}'}" FontSize="11" Foreground="{StaticResource AccentCyan}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 2-Column: Title Formulas & Hook Strategies -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Column 1: Title Formulas -->
                                        <Border Grid.Column="0" Background="#141124" CornerRadius="8" Padding="12" BorderBrush="#382d5a" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="📌 Công Thức Đặt Tiêu Đề (Title Formulas)" FontSize="12" FontWeight="Bold" Foreground="#89b4fa" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding ChannelAiAnalysis.TitleFormulas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1c1730" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#2a2245" BorderThickness="1">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#a6e3a1"/>
                                                                    <TextBlock Text="{Binding Formula, StringFormat='Cú pháp: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#f9e2af" Margin="0,2,0,4" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding WhyItWorks}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding Example, StringFormat='Ví dụ: {0}'}" FontSize="10" Foreground="#fab387" FontStyle="Italic" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- Column 2: Hook Strategies -->
                                        <Border Grid.Column="2" Background="#141124" CornerRadius="8" Padding="12" BorderBrush="#382d5a" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="🎣 Chiến Lược Retention Hook (0-15s đầu)" FontSize="12" FontWeight="Bold" Foreground="#f38ba8" Margin="0,0,0,8"/>
                                                <ItemsControl ItemsSource="{Binding ChannelAiAnalysis.HookStrategies}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1c1730" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#2a2245" BorderThickness="1">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding HookType}" FontSize="12" FontWeight="Bold" Foreground="#cba6f7"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                                                                    <TextBlock Text="{Binding ExampleScript, StringFormat='Ví dụ câu thoại: {0}'}" FontSize="10" Foreground="#94e2d5" FontStyle="Italic" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Suggested Video Ideas (Ready to copy/create) -->
                                    <Border Background="#141124" CornerRadius="8" Padding="12" BorderBrush="#382d5a" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="💡 5 Ý Tưởng Tiêu Đề &amp; Hook Áp Dụng Ngay (Sao Chép Vào Tool Kịch Bản)" FontSize="12" FontWeight="Bold" Foreground="#f9e2af" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding ChannelAiAnalysis.SuggestedIdeas}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#1c1730" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#2a2245" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="#89b4fa" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding HookOpening, StringFormat='Hook mở màn: {0}'}" FontSize="11" Foreground="#cdd6f4" TextWrapping="Wrap" Margin="0,3,0,2"/>
                                                                    <TextBlock Text="{Binding TargetEmotion, StringFormat='Tâm lý nhắm tới: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                    <Button Command="{Binding DataContext.CreateVideoFromIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="🎬 Tạo Video Tương Tự ▾" Padding="14,6" Margin="0,0,6,0"
                                                                            Background="#724cb8" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand"
                                                                            ToolTip="Click để chọn Tạo 1 Tập hoặc Tạo Series Nhiều Tập (Chuột phải để chọn nhanh)">
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu Background="#1a182d" Foreground="White" BorderBrush="#3f3765">
                                                                                <MenuItem Header="🎬 Tạo Video Đơn (1 Tập)" 
                                                                                          Command="{Binding DataContext.CreateSingleVideoFromIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                          CommandParameter="{Binding}"/>
                                                                                <MenuItem Header="📺 Tạo Chuỗi Series (Nhiều Tập)" 
                                                                                          Command="{Binding DataContext.CreateSeriesFromIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                          CommandParameter="{Binding}"/>
                                                                            </ContextMenu>
                                                                        </Button.ContextMenu>
                                                                    </Button>
                                                                    <Button Command="{Binding DataContext.UseSuggestedIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Content="📋 Sao Chép" Padding="10,6" FontSize="11" Cursor="Hand"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Toggle: Top Videos vs Latest -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="10,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="🏆 Top Video (Nhiều Lượt Xem Nhất)"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowTopVideos}" Value="False">
                                                    <Setter Property="Text" Value="🕐 Video Mới Nhất"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Command="{Binding ToggleVideoListCommand}" Padding="10,4" FontSize="11">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Content" Value="Xem Video Mới Nhất →"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowTopVideos}" Value="False">
                                                    <Setter Property="Content" Value="← Xem Top Video"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Top Videos List -->
                        <ItemsControl Visibility="{Binding ShowTopVideos, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl.ItemsSource>
                                <Binding Path="ChannelTopVideos"/>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141427" CornerRadius="8" Padding="10" Margin="0,0,0,6" BorderBrush="#2a2a3e" BorderThickness="1" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Rank -->
                                            <TextBlock Grid.Column="0" Text="{Binding RankBadge}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" TextAlignment="Center"/>
                                            <!-- Thumbnail -->
                                            <Border Grid.Column="1" Width="80" Height="45" CornerRadius="4" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <!-- Title & Duration -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding DurationDisplay}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text=" • " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding PublishedAgo}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Views -->
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding ViewCountDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                                <TextBlock Text="views" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                            <!-- Likes -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding LikeCountDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                                <TextBlock Text="likes" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                            <!-- Engagement -->
                                            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock Text="{Binding EngagementRateDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource YtAccentOrange}"/>
                                                <TextBlock Text="engage" FontSize="9" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                            <!-- Tạo Video Button -->
                                            <Button Grid.Column="6" Content="🎬 Tạo Video ▾" FontSize="11" FontWeight="SemiBold"
                                                    Background="#2d1d4f" Foreground="#cba6f7" BorderBrush="#724cb8" BorderThickness="1"
                                                    Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                                                    ToolTip="Click để chọn Tạo 1 Tập hoặc Tạo Series Nhiều Tập (Chuột phải để chọn nhanh)"
                                                    Command="{Binding DataContext.CreateVideoFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Background="#1a182d" Foreground="White" BorderBrush="#3f3765">
                                                        <MenuItem Header="🎬 Tạo Video Đơn (1 Tập)" 
                                                                  Command="{Binding DataContext.CreateSingleVideoFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📺 Tạo Chuỗi Series (Nhiều Tập)" 
                                                                  Command="{Binding DataContext.CreateSeriesFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <!-- Open URL -->
                                            <Button Grid.Column="7" Content="↗" FontSize="14" ToolTip="Mở video trên YouTube" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.OpenVideoUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}" Width="30" Height="30" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Latest Videos List -->
                        <ItemsControl Visibility="{Binding ShowTopVideos, Converter={StaticResource InverseBoolToVisConverter}}">
                            <ItemsControl.ItemsSource>
                                <Binding Path="ChannelLatestVideos"/>
                            </ItemsControl.ItemsSource>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141427" CornerRadius="8" Padding="10" Margin="0,0,0,6" BorderBrush="#2a2a3e" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="80" Height="45" CornerRadius="4" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PublishedAgo}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ViewCountDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding EngagementRateDisplay}" FontSize="12" Foreground="{StaticResource YtAccentOrange}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <!-- Tạo Video Button -->
                                            <Button Grid.Column="4" Content="🎬 Tạo Video ▾" FontSize="11" FontWeight="SemiBold"
                                                    Background="#2d1d4f" Foreground="#cba6f7" BorderBrush="#724cb8" BorderThickness="1"
                                                    Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                                                    ToolTip="Click để chọn Tạo 1 Tập hoặc Tạo Series Nhiều Tập (Chuột phải để chọn nhanh)"
                                                    Command="{Binding DataContext.CreateVideoFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Background="#1a182d" Foreground="White" BorderBrush="#3f3765">
                                                        <MenuItem Header="🎬 Tạo Video Đơn (1 Tập)" 
                                                                  Command="{Binding DataContext.CreateSingleVideoFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📺 Tạo Chuỗi Series (Nhiều Tập)" 
                                                                  Command="{Binding DataContext.CreateSeriesFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Grid.Column="5" Content="↗" FontSize="14" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.OpenVideoUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}" Width="30" Height="30" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Placeholder / Empty State khi chưa phân tích kênh: Gợi ý tìm top kênh theo chủ đề -->
                    <Border Background="#16152a" CornerRadius="12" Padding="28,24" Margin="0,4,0,0" BorderBrush="#2e2b4f" BorderThickness="1.5"
                            Visibility="{Binding HasChannelResult, Converter={StaticResource InverseBoolToVisConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🏆" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="BẠN CHƯA CÓ KÊNH CỤ THỂ? HÃY TÌM TOP KÊNH THEO CHỦ ĐỀ!" FontSize="16" FontWeight="Bold" Foreground="#cba6f7" HorizontalAlignment="Center"/>
                                <TextBlock Text="Nhập bất kỳ chủ đề ngách nào (như review phim, kể chuyện kinh dị, kiến thức khoa học, tài chính cá nhân...) để hệ thống tự động quét và lọc ra những kênh sở hữu lượt xem (views) cao nhất!" 
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="700" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Button Command="{Binding SwitchToTopicChannelsTabCommand}" Background="#724cb8" Foreground="White" FontWeight="Bold" Padding="20,10" FontSize="13" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mở Tính Năng Tìm Top Kênh Theo Chủ Đề" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ➔" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <WrapPanel Grid.Row="2" HorizontalAlignment="Center">
                                <TextBlock Text="💡 Bấm chọn nhanh chủ đề:" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <Button Content="🎬 Review Phim" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="review phim" Style="{StaticResource TagPillBtn}"/>
                                <Button Content="👻 Kể Chuyện Kinh Dị" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="kể chuyện kinh dị" Style="{StaticResource TagPillBtn}"/>
                                <Button Content="🏛️ Lịch Sử Thế Giới" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="lịch sử thế giới" Style="{StaticResource TagPillBtn}"/>
                                <Button Content="💰 Tài Chính &amp; Đầu Tư" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="tài chính làm giàu" Style="{StaticResource TagPillBtn}"/>
                                <Button Content="🧠 Khoa Học &amp; Vũ Trụ" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="khoa học vũ trụ" Style="{StaticResource TagPillBtn}"/>
                                <Button Content="🍳 Ẩm Thực &amp; Nấu Ăn" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="ẩm thực nấu ăn" Style="{StaticResource TagPillBtn}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ TAB: TOP KÊNH THEO CHỦ ĐỀ ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ElementName=TabTopic, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="0,0,0,10">
                    <!-- Search Bar by Topic -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="16" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Topic Input Box -->
                                <TextBox Text="{Binding TopicKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource SearchBox}"
                                         x:Name="TopicSearchBox"
                                         KeyDown="TopicSearchBox_KeyDown"
                                         Tag="Nhập chủ đề kênh cần tìm (VD: review phim, kể chuyện kinh dị, kiến thức khoa học, podcast, nấu ăn...)..." 
                                         Margin="0,0,10,0"/>

                                <!-- Country / Region -->
                                <TextBox Grid.Column="1" Text="{Binding TopicRegionCode, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource SearchBox}" 
                                         Width="55" Margin="0,0,10,0" TextAlignment="Center" 
                                         ToolTip="Mã quốc gia (VN: Việt Nam, US: Hoa Kỳ, hoặc xóa trống để tìm Toàn cầu)"/>

                                <!-- Search Button -->
                                <Button Grid.Column="2" Command="{Binding SearchTopChannelsByTopicCommand}" Style="{StaticResource YtBtn}" Padding="20,9"
                                        IsEnabled="{Binding IsLoadingTopicChannels, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚀" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Quét Top Kênh Nhiều View" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Second Row: Sort Radio Buttons & Quick Tag Pills -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sort Options -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="Sắp xếp:" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <RadioButton Content="👁️ Nhiều View Nhất" Style="{StaticResource SortRadioBtn}" IsChecked="{Binding IsSortByViews, Mode=TwoWay}" GroupName="TopicSortGroup"/>
                                    <RadioButton Content="👥 Nhiều Subs Nhất" Style="{StaticResource SortRadioBtn}" IsChecked="{Binding IsSortBySubs, Mode=TwoWay}" GroupName="TopicSortGroup"/>
                                    <RadioButton Content="📈 TB View/Video Cao" Style="{StaticResource SortRadioBtn}" IsChecked="{Binding IsSortByAvg, Mode=TwoWay}" GroupName="TopicSortGroup"/>
                                </StackPanel>

                                <!-- Quick Topic Tags -->
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="💡 Gợi ý:" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                    <Button Content="🎬 Review Phim" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="review phim" Style="{StaticResource TagPillBtn}"/>
                                    <Button Content="👻 Kể Chuyện Kinh Dị" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="kể chuyện kinh dị" Style="{StaticResource TagPillBtn}"/>
                                    <Button Content="🏛️ Lịch Sử Thế Giới" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="lịch sử thế giới" Style="{StaticResource TagPillBtn}"/>
                                    <Button Content="💰 Tài Chính Làm Giàu" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="tài chính làm giàu" Style="{StaticResource TagPillBtn}"/>
                                    <Button Content="🧠 Khoa Học" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="khoa học vũ trụ" Style="{StaticResource TagPillBtn}"/>
                                    <Button Content="🍳 Ẩm Thực" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="ẩm thực nấu ăn" Style="{StaticResource TagPillBtn}"/>
                                    <Button Content="🎧 Podcast" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="podcast tâm sự" Style="{StaticResource TagPillBtn}"/>
                                    <Button Content="🎮 Gaming" Command="{Binding ApplyQuickTopicCommand}" CommandParameter="gaming" Style="{StaticResource TagPillBtn}"/>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Initial Placeholder State (When no search has been performed yet) -->
                    <Border Background="#16152a" CornerRadius="12" Padding="28,24" BorderBrush="#2e2b4f" BorderThickness="1.5" Margin="0,0,0,12"
                            Visibility="{Binding HasTopicChannelsResult, Converter={StaticResource InverseBoolToVisConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🏆" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="TÌM RA NHỮNG ÔNG TRÙM TRIỆU VIEW THEO TỪNG CHỦ ĐỀ" FontSize="16" FontWeight="Bold" Foreground="#fab387" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chỉ cần nhập chủ đề bất kỳ hoặc bấm vào các nút gợi ý phía trên. Thuật toán sẽ tự động phân tích hàng nghìn kênh trên YouTube, đo lường tổng lượt xem của từng kênh và xếp hạng những kênh có lượt view cao nhất để bạn nghiên cứu đối thủ &amp; lấy ý tưởng sản xuất video!" 
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" MaxWidth="720" Margin="0,8,0,0" LineHeight="19" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Results Section -->
                    <StackPanel Visibility="{Binding HasTopicChannelsResult, Converter={StaticResource BoolToVisConverter}}">
                        <!-- Results Summary Banner -->
                        <Border Background="#1a1835" CornerRadius="10" Padding="14,10" BorderBrush="#4a3e7a" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏆" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TopicSearchSummary}" FontSize="13" FontWeight="Bold" Foreground="#a6e3a1" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#2a1e4a" CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="{Binding TotalTopicViewsDisplay, StringFormat='👁️ Tổng Views: {0}'}" FontSize="12" FontWeight="Bold" Foreground="#89b4fa"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Channel Cards List -->
                        <ItemsControl ItemsSource="{Binding TopicChannels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141427" CornerRadius="10" Padding="14" Margin="0,0,0,8" BorderBrush="#2a2a45" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Rank -->
                                                <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                                                <ColumnDefinition Width="*"/>    <!-- Info & Stats -->
                                                <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Rank Badge -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#1e1c36" BorderBrush="#3f3868" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding RankBadge}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Avatar -->
                                            <Border Grid.Column="1" Width="64" Height="64" CornerRadius="32" BorderBrush="{StaticResource YtRed}" BorderThickness="2" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>

                                            <!-- Info & Stats -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                    <Border Background="#2a1625" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CustomUrl}" FontSize="10" Foreground="{StaticResource YtAccentPink}"/>
                                                    </Border>
                                                    <Border Background="#1a2520" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Country}" FontSize="10" Foreground="{StaticResource AccentGreen}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding ChannelAge, StringFormat='Hoạt động: {0}'}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Description -->
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" 
                                                           TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,3,0,6"/>

                                                <!-- 4 Stat Badges (Prominent Views Badge!) -->
                                                <StackPanel Orientation="Horizontal">
                                                    <!-- Total Views (Highlighted) -->
                                                    <Border Background="#18253e" BorderBrush="#3665a8" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👁️" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ViewCountDisplay, StringFormat='{}{0} views'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Subs -->
                                                    <Border Background="#2e1922" BorderBrush="#7d283f" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👥" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding SubscriberDisplay, StringFormat='{}{0} subs'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource YtRed}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Videos -->
                                                    <Border Background="#192823" BorderBrush="#2e6d4c" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🎬" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding VideoCountDisplay, StringFormat='{}{0} videos'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Avg Views per Video -->
                                                    <Border Background="#2d2218" BorderBrush="#784e2a" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📈" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AvgViewsPerVideoDisplay, StringFormat='TB {0}/video'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource YtAccentOrange}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Phân Tích Sâu Kênh -->
                                                <Button Command="{Binding DataContext.AnalyzeSelectedChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="14,8" Margin="0,0,8,0" Background="#724cb8" Foreground="White" FontWeight="Bold" FontSize="11.5" Cursor="Hand"
                                                        ToolTip="Chuyển sang tab Phân Tích Kênh để tải top video, video mới nhất và chạy Gemini AI bóc tách công thức hook">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🔍" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Phân Tích Kênh" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Tạo Video ▾ -->
                                                <Button Content="🎬 Tạo Video ▾" FontSize="11" FontWeight="SemiBold"
                                                        Background="#2d1d4f" Foreground="#cba6f7" BorderBrush="#724cb8" BorderThickness="1"
                                                        Padding="10,7" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                                                        ToolTip="Click để chọn Tạo 1 Tập hoặc Tạo Series Nhiều Tập (Chuột phải để chọn nhanh)"
                                                        Command="{Binding DataContext.CreateVideoFromChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Background="#1a182d" Foreground="White" BorderBrush="#3f3765">
                                                            <MenuItem Header="🎬 Tạo Video Đơn (1 Tập)" 
                                                                      Command="{Binding DataContext.CreateSingleVideoFromChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="📺 Tạo Chuỗi Series (Nhiều Tập)" 
                                                                      Command="{Binding DataContext.CreateSeriesFromChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>

                                                <!-- Open URL -->
                                                <Button Content="↗" FontSize="14" ToolTip="Mở kênh trên YouTube" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.OpenVideoUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Url}" Width="32" Height="32" Padding="0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ TAB 1: PHÂN TÍCH VIDEO ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ElementName=Tab1, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="0,0,0,10">
                    <!-- Search Bar -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding VideoInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                                     Tag="Dán URL video YouTube hoặc Video ID..." Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Command="{Binding AnalyzeVideoCommand}" Style="{StaticResource YtBtn}" Padding="18,8"
                                    IsEnabled="{Binding IsLoadingVideo, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎬" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Phân Tích Video" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Video Result -->
                    <StackPanel Visibility="{Binding HasVideoResult, Converter={StaticResource BoolToVisConverter}}">
                        <!-- Video Preview -->
                        <Border Background="#141427" CornerRadius="12" Padding="18" BorderBrush="#2a2a45" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="200" Height="112" CornerRadius="8" Margin="0,0,16,0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding VideoInfo.ThumbnailUrl}" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VideoInfo.Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding VideoInfo.ChannelTitle}" FontSize="12" Foreground="{StaticResource AccentBlue}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding VideoInfo.PublishedAgo}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock Text="{Binding VideoInfo.DurationDisplay}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Command="{Binding CreateVideoFromCurrentVideoCommand}"
                                                Background="#724cb8" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="0,0,10,0"
                                                Cursor="Hand" ToolTip="Click để chọn Tạo 1 Tập hoặc Tạo Series Nhiều Tập (Chuột phải để chọn nhanh)">
                                            <Button.ContextMenu>
                                                <ContextMenu Background="#1a182d" Foreground="White" BorderBrush="#3f3765">
                                                    <MenuItem Header="🎬 Tạo Video Đơn (1 Tập)" Command="{Binding CreateSingleVideoFromCurrentVideoCommand}"/>
                                                    <MenuItem Header="📺 Tạo Chuỗi Series (Nhiều Tập)" Command="{Binding CreateSeriesFromCurrentVideoCommand}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🎬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tạo Video Tương Tự Từ Video Này ▾" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Content="↗ Mở trên YouTube" Padding="10,6" FontSize="11"
                                                Command="{Binding OpenVideoUrlCommand}" CommandParameter="{Binding VideoInfo.Url}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Video Stats -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="👁️ Views" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding VideoInfo.ViewCountDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="👍 Likes" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding VideoInfo.LikeCountDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="💬 Comments" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding VideoInfo.CommentCountDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource YtAccentPurple}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="📊 Engagement" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding VideoInfo.EngagementRateDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource YtAccentOrange}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="8" Style="{StaticResource StatCard}">
                                <StackPanel>
                                    <TextBlock Text="❤️ Like/View" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding VideoInfo.LikePerViewDisplay}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource YtAccentPink}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 🧠 AI Video Breakdown -->
                        <Border Background="#1c1630" CornerRadius="12" Padding="14" BorderBrush="#724cb8" BorderThickness="1.5" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🧠" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="GEMINI AI: PHÂN TÍCH TIÊU ĐỀ &amp; RETENTION HOOK CỦA VIDEO NÀY" FontSize="13" FontWeight="Bold" Foreground="#cba6f7" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Giải mã vì sao video này lại thu hút lượt xem, cấu trúc tiêu đề và các ý tưởng kịch bản tương tự." 
                                                   FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="24,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding AnalyzeVideoAiCommand}" 
                                            Background="#724cb8" Foreground="White" FontWeight="Bold" Padding="14,6" Cursor="Hand"
                                            IsEnabled="{Binding IsLoadingAiAnalysis, Converter={StaticResource InverseBoolConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✨" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="AI Bóc Tách Video" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Video AI Result -->
                                <StackPanel Visibility="{Binding HasVideoAiAnalysis, Converter={StaticResource BoolToVisConverter}}" Margin="0,12,0,0">
                                    <Border Height="1" Background="#382d5a" Margin="0,0,0,10"/>
                                    <Border Background="#141124" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#382d5a" BorderThickness="1">
                                        <TextBlock Text="{Binding VideoAiAnalysis.Summary}" FontSize="12" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                                    </Border>
                                    <!-- Suggested ideas -->
                                    <ItemsControl ItemsSource="{Binding VideoAiAnalysis.SuggestedIdeas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141124" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="#2a2245" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="#89b4fa"/>
                                                            <TextBlock Text="{Binding HookOpening, StringFormat='Hook: {0}'}" FontSize="10" Foreground="#cdd6f4" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <Button Command="{Binding DataContext.CreateVideoFromIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Content="🎬 Tạo Video Ngay ▾" Padding="12,5" Margin="0,0,6,0"
                                                                    Background="#724cb8" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand"
                                                                    ToolTip="Click để chọn Tạo 1 Tập hoặc Tạo Series Nhiều Tập (Chuột phải để chọn nhanh)">
                                                                <Button.ContextMenu>
                                                                    <ContextMenu Background="#1a182d" Foreground="White" BorderBrush="#3f3765">
                                                                        <MenuItem Header="🎬 Tạo Video Đơn (1 Tập)" 
                                                                                  Command="{Binding DataContext.CreateSingleVideoFromIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  CommandParameter="{Binding}"/>
                                                                        <MenuItem Header="📺 Tạo Chuỗi Series (Nhiều Tập)" 
                                                                                  Command="{Binding DataContext.CreateSeriesFromIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                  CommandParameter="{Binding}"/>
                                                                    </ContextMenu>
                                                                </Button.ContextMenu>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.UseSuggestedIdeaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Content="📋 Copy" Padding="8,5" FontSize="11" Cursor="Hand"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Tags -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🏷️ Tags" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                    <Button Grid.Column="1" Content="📋 Copy Tags" Padding="8,3" FontSize="10"
                                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding VideoInfo.Tags}"/>
                                </Grid>
                                <TextBlock Text="{Binding VideoInfo.Tags}" FontSize="11" Foreground="{StaticResource AccentCyan}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Description -->
                        <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="📝 Mô Tả Video" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding VideoInfo.Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxHeight="200"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ TAB 2: SO SÁNH ĐỐI THỦ ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ElementName=Tab2, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="0,0,0,10">
                    <!-- Search Bars -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📌 Kênh của bạn:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120"/>
                                <TextBox Grid.Column="1" Text="{Binding MyChannelInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                                         Tag="URL hoặc @handle kênh YouTube của bạn"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🆚 Kênh đối thủ:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource YtRed}" VerticalAlignment="Center" Margin="0,0,10,0" Width="120"/>
                                <TextBox Grid.Column="1" Text="{Binding CompetitorChannelInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                                         Tag="URL hoặc @handle kênh đối thủ"/>
                            </Grid>
                            <Button Command="{Binding CompareChannelsCommand}" Style="{StaticResource YtBtn}" Padding="18,8" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsLoadingComparison, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚔️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="So Sánh Hai Kênh" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Comparison Result -->
                    <Grid Visibility="{Binding HasComparisonResult, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- My Channel -->
                        <Border Grid.Column="0" Background="#141427" CornerRadius="12" Padding="14" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1.5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#1a2a1e" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="📌 KÊNH CỦA BẠN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </Border>
                                    <TextBlock Text="{Binding MyChannelComparison.Channel.Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding MyChannelComparison.Channel.SubscriberDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource YtRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Subs" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding MyChannelComparison.Channel.ViewCountDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Views" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding MyChannelComparison.Channel.VideoCountDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Videos" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding MyChannelComparison.Channel.AvgViewsPerVideoDisplay, StringFormat='TB Views/Video: {0}'}" FontSize="11" Foreground="{StaticResource YtAccentOrange}"/>
                            </StackPanel>
                        </Border>

                        <!-- VS Badge -->
                        <TextBlock Grid.Column="1" Text="VS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource YtRed}" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <!-- Competitor Channel -->
                        <Border Grid.Column="2" Background="#141427" CornerRadius="12" Padding="14" BorderBrush="{StaticResource AccentRed}" BorderThickness="1.5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Background="#2a1a1e" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="🆚 ĐỐI THỦ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/>
                                    </Border>
                                    <TextBlock Text="{Binding CompetitorComparison.Channel.Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CompetitorComparison.Channel.SubscriberDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource YtRed}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Subs" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CompetitorComparison.Channel.ViewCountDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Views" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CompetitorComparison.Channel.VideoCountDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Videos" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding CompetitorComparison.Channel.AvgViewsPerVideoDisplay, StringFormat='TB Views/Video: {0}'}" FontSize="11" Foreground="{StaticResource YtAccentOrange}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ TAB 3: TRENDING & TỪ KHÓA ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ElementName=Tab3, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel Margin="0,0,0,10">
                    <!-- Search Bar -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="14" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}"
                                         Tag="Nhập từ khóa tìm kiếm (VD: cooking hacks, AI tutorial...)" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1" Text="{Binding RegionCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" 
                                         Width="60" Margin="0,0,10,0" TextAlignment="Center" ToolTip="Mã quốc gia (VN, US, JP...)"/>
                                <Button Grid.Column="2" Command="{Binding SearchKeywordCommand}" Style="{StaticResource YtBtn}" Padding="18,8"
                                        IsEnabled="{Binding IsLoadingSearch, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔍" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tìm Kiếm" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Button Command="{Binding LoadTrendingCommand}" Padding="12,6" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsLoadingSearch, Converter={StaticResource InverseBoolConverter}}"
                                    Background="#2d1f14" Foreground="{StaticResource YtAccentOrange}" BorderBrush="#5a3a1e" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔥" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RegionCode, StringFormat='Tải Video Trending ({0})'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Search Results -->
                    <StackPanel Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="🔍 Kết Quả Tìm Kiếm" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141427" CornerRadius="8" Padding="10" Margin="0,0,0,6" BorderBrush="#2a2a3e" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="100" Height="56" CornerRadius="4" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding ChannelTitle}" FontSize="10" Foreground="{StaticResource AccentBlue}"/>
                                                    <TextBlock Text=" • " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding PublishedAgo}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding ViewCountDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <Button Grid.Column="3" Content="🎬 Tạo Video ▾" FontSize="11" FontWeight="SemiBold"
                                                    Background="#2d1d4f" Foreground="#cba6f7" BorderBrush="#724cb8" BorderThickness="1"
                                                    Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                                                    ToolTip="Click để chọn Tạo 1 Tập hoặc Tạo Series Nhiều Tập (Chuột phải để chọn nhanh)"
                                                    Command="{Binding DataContext.CreateVideoFromSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Background="#1a182d" Foreground="White" BorderBrush="#3f3765">
                                                        <MenuItem Header="🎬 Tạo Video Đơn (1 Tập)" 
                                                                  Command="{Binding DataContext.CreateSingleVideoFromSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📺 Tạo Chuỗi Series (Nhiều Tập)" 
                                                                  Command="{Binding DataContext.CreateSeriesFromSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Grid.Column="4" Content="↗" FontSize="14" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.OpenVideoUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}" Width="30" Height="30" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Trending Results -->
                    <StackPanel Visibility="{Binding HasTrendingResults, Converter={StaticResource BoolToVisConverter}}" Margin="0,10,0,0">
                        <TextBlock Text="🔥 Video Trending" FontSize="13" FontWeight="Bold" Foreground="{StaticResource YtAccentOrange}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding TrendingVideos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#141427" CornerRadius="8" Padding="10" Margin="0,0,0,6" BorderBrush="#2a2a3e" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding RankBadge}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" Width="28" TextAlignment="Center"/>
                                            <Border Grid.Column="1" Width="100" Height="56" CornerRadius="4" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding ChannelTitle}" FontSize="10" Foreground="{StaticResource AccentBlue}"/>
                                                    <TextBlock Text=" • " FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBlock Text="{Binding PublishedAgo}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="3" Text="{Binding ViewCountDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding EngagementRateDisplay}" FontSize="12" Foreground="{StaticResource YtAccentOrange}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <Button Grid.Column="5" Content="🎬 Tạo Video ▾" FontSize="11" FontWeight="SemiBold"
                                                    Background="#2d1d4f" Foreground="#cba6f7" BorderBrush="#724cb8" BorderThickness="1"
                                                    Padding="10,5" Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                                                    ToolTip="Click để chọn Tạo 1 Tập hoặc Tạo Series Nhiều Tập (Chuột phải để chọn nhanh)"
                                                    Command="{Binding DataContext.CreateVideoFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.ContextMenu>
                                                    <ContextMenu Background="#1a182d" Foreground="White" BorderBrush="#3f3765">
                                                        <MenuItem Header="🎬 Tạo Video Đơn (1 Tập)" 
                                                                  Command="{Binding DataContext.CreateSingleVideoFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="📺 Tạo Chuỗi Series (Nhiều Tập)" 
                                                                  Command="{Binding DataContext.CreateSeriesFromVideoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                            <Button Grid.Column="6" Content="↗" FontSize="14" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.OpenVideoUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}" Width="30" Height="30" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Border Background="#80181825" CornerRadius="12" 
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════ FOOTER STATUS BAR ═══════════ -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource BgCard}" CornerRadius="10" Padding="14,8" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Đóng" Click="CloseButton_Click" Padding="16,6" MinWidth="80"/>
            </Grid>
        </Border>

        <!-- ═══════════ MODAL POPUP: CHỌN HÌNH THỨC TẠO VIDEO (1 TẬP HOẶC NHIỀU TẬP) ═══════════ -->
        <Border Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="1000" Margin="-18"
                Background="#D0090914"
                Visibility="{Binding IsCreationChoicePopupOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#161528" BorderBrush="#3f3765" BorderThickness="1.5" CornerRadius="16"
                    MaxWidth="780" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Direction="270" Opacity="0.65" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Info Candidate Card -->
                        <RowDefinition Height="Auto"/> <!-- 2 Choice Cards -->
                        <RowDefinition Height="Auto"/> <!-- Footer Tips & Cancel -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚀" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CHỌN HÌNH THỨC SẢN XUẤT VIDEO TỰ ĐỘNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                                <Border Background="#2a1f4a" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="AI Video Engine" FontSize="10" FontWeight="Bold" Foreground="#cba6f7"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Bạn muốn dựng 1 tập video độc lập hay lập kế hoạch chuỗi video nhiều tập liền mạch?" 
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="28,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CancelCreationChoicePopupCommand}"
                                Content="✕" Width="32" Height="32" Padding="0" FontSize="14" FontWeight="Bold"
                                Background="#26243d" Foreground="{StaticResource TextMuted}" BorderBrush="#3d3860" BorderThickness="1"
                                Cursor="Hand" ToolTip="Đóng popup"/>
                    </Grid>

                    <!-- Row 1: Candidate Info Card -->
                    <Border Grid.Row="1" Background="#1c1a32" CornerRadius="10" Padding="14,10" Margin="0,0,0,18" BorderBrush="#352e55" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🎯 Chủ đề / Ý tưởng:" FontSize="11" FontWeight="Bold" Foreground="#fab387" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ActiveCandidateRequest.Title}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🪝 Hook mở đầu 0-15s:" FontSize="11" FontWeight="Bold" Foreground="#94e2d5" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ActiveCandidateRequest.HookOpening}" FontSize="11" Foreground="#cdd6f4" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: 2 Side-by-Side Choice Cards -->
                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CARD 1: TẠO VIDEO ĐƠN (1 TẬP) -->
                        <Border Grid.Column="0" Background="#18152e" CornerRadius="12" Padding="18" BorderBrush="#5e3da8" BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card 1 Header -->
                                <StackPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#2a1d4f" Margin="0,0,10,0">
                                            <TextBlock Text="🎬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="TẠO MỘT TẬP" FontSize="15" FontWeight="Bold" Foreground="#cba6f7"/>
                                            <TextBlock Text="Video Độc Lập (Script Generator)" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="#201a38" CornerRadius="4" Padding="6,3" Margin="0,4,0,10">
                                        <TextBlock Text="⚡ Nhanh gọn • 1 kịch bản hoàn chỉnh" FontSize="10.5" FontWeight="SemiBold" Foreground="#a6e3a1"/>
                                    </Border>
                                </StackPanel>

                                <!-- Card 1 Features -->
                                <StackPanel Grid.Row="1" Margin="0,4,0,16">
                                    <TextBlock Text="• Tối ưu Retention Hook 0-15s mở màn thu hút" FontSize="11.5" Foreground="#cdd6f4" Margin="0,3,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Tự động chia Scene, tạo Visual Prompt chi tiết" FontSize="11.5" Foreground="#cdd6f4" Margin="0,3,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Lồng tiếng AI (TTS) &amp; Phụ đề Karaoke nhảy chữ" FontSize="11.5" Foreground="#cdd6f4" Margin="0,3,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Thích hợp: Shorts, Reels, TikTok, video triệu view lẻ" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Card 1 Button -->
                                <Button Grid.Row="2" Command="{Binding ConfirmCreateSingleVideoCommand}"
                                        Background="#724cb8" Foreground="White" FontWeight="Bold" FontSize="12.5" Padding="14,10"
                                        Cursor="Hand" ToolTip="Mở trình soạn kịch bản 1 tập với dữ liệu đã phân tích">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🎬" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mở Popup Tạo 1 Tập" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ➔" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- CARD 2: TẠO SERI NHIỀU TẬP (SERIES) -->
                        <Border Grid.Column="2" Background="#131934" CornerRadius="12" Padding="18" BorderBrush="#2e5090" BorderThickness="1.5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card 2 Header -->
                                <StackPanel Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="38" Height="38" CornerRadius="19" Background="#1b2a52" Margin="0,0,10,0">
                                            <TextBlock Text="📺" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="TẠO SERI NHIỀU TẬP" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                                            <TextBlock Text="Chuỗi Video Dài Kỳ (Series Creator)" FontSize="10.5" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Background="#162242" CornerRadius="4" Padding="6,3" Margin="0,4,0,10">
                                        <TextBlock Text="🔥 Cốt truyện liền mạch • 2 - 10 Tập" FontSize="10.5" FontWeight="SemiBold" Foreground="#89b4fa"/>
                                    </Border>
                                </StackPanel>

                                <!-- Card 2 Features -->
                                <StackPanel Grid.Row="1" Margin="0,4,0,16">
                                    <TextBlock Text="• AI Lập kế hoạch phân chia cốt truyện nhiều phần" FontSize="11.5" Foreground="#cdd6f4" Margin="0,3,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Tự động xây dựng Character Bible (nhân vật nhất quán)" FontSize="11.5" Foreground="#cdd6f4" Margin="0,3,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Cài cắm Cliffhanger gay cấn cuối mỗi tập giữ chân" FontSize="11.5" Foreground="#cdd6f4" Margin="0,3,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Thích hợp: Vụ án bí ẩn, mini-series, chuỗi bài học" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Card 2 Button -->
                                <Button Grid.Row="2" Command="{Binding ConfirmCreateSeriesVideoCommand}"
                                        Background="#1e66f5" Foreground="White" FontWeight="Bold" FontSize="12.5" Padding="14,10"
                                        Cursor="Hand" ToolTip="Mở trình khởi tạo chuỗi video nhiều tập với dữ liệu đã phân tích">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="📺" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Mở Popup Tạo Seri" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" ➔" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 3: Footer note and Cancel Button -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💡 Mẹo: Click chuột phải trực tiếp vào các nút 'Tạo Video' trên danh sách để chọn nhanh 1 tập hoặc series."
                                   FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding CancelCreationChoicePopupCommand}"
                                Content="Hủy bỏ" Padding="16,6" Background="Transparent" Foreground="{StaticResource TextSecondary}"
                                BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
