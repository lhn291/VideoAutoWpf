<Window x:Class="VideoAutoWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:VideoAutoWpf.ViewModels"
        mc:Ignorable="d"
        Title="VideoAuto Minimal - Sản Xuất Video AI Đơn Giản &amp; Ổn Định" 
        Height="900" Width="1440" 
        MinHeight="760" MinWidth="1100"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Error Banner -->
            <RowDefinition Height="Auto" />
            <!-- 2: Main Content (2 Columns) -->
            <RowDefinition Height="*" />
            <!-- 3: Bottom Status & Progress -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  HEADER: TÊN DỰ ÁN & CÁC NÚT ĐIỀU HƯỚNG NHANH           -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentCyan}" />
                    <StackPanel>
                        <TextBlock Text="VIDEOAUTO MINIMAL" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Quy trình sản xuất video AI 8 bước tinh gọn • Không tác vụ ngầm • Không tắt máy" FontSize="11.5" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Project Directory Indicator -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding ProjectName, StringFormat='📁 Dự án: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" />
                    <TextBlock Text="{Binding ProjectDirectory}" FontSize="10.5" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nút Hủy Tác Vụ (Chỉ hiện khi IsBusy) -->
                    <Button Content="🛑 HỦY TÁC VỤ" Command="{Binding CancelCurrentTaskCommand}" 
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                            Background="{StaticResource AccentRed}" Foreground="#181825" FontWeight="Bold" 
                            Padding="14,7" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand" />

                    <Button Content="➕ Dự Án Mới" Command="{Binding NewProjectCommand}" 
                            Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                            Padding="12,7" Margin="0,0,8,0" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" />

                    <Button Content="📂 Mở Dự Án Cũ" Command="{Binding LoadExistingProjectCommand}" 
                            Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                            Padding="12,7" Margin="0,0,8,0" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" />

                    <Button Content="📁 Mở Thư Mục" Command="{Binding OpenProjectFolderCommand}" 
                            Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                            Padding="12,7" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  ERROR BANNER (Hiện khi có lỗi)                          -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#3e1b24" BorderBrush="{StaticResource AccentRed}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" 
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ " FontSize="15" Foreground="{StaticResource AccentRed}" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Medium" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  MAIN CONTENT: 2 CỘT (Cấu hình/Dàn ý & Kịch bản/Media)  -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Cột Trái: Bước 1 (Chủ đề & Cấu hình) + Bước 2 (Dàn ý) -->
                <ColumnDefinition Width="480" MinWidth="380" MaxWidth="600" />
                <ColumnDefinition Width="14" />
                <!-- Cột Phải: Bước 3 (Kịch bản) + Bước 4-7 (Media & Render) + Bước 8 (Hoàn thành) -->
                <ColumnDefinition Width="*" MinWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- ── CỘT TRÁI ── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">

                    <!-- CARD BƯỚC 1: NHẬP CHỦ ĐỀ & CẤU HÌNH -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="BƯỚC 1: NHẬP CHỦ ĐỀ &amp; THIẾT LẬP" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource AccentCyan}" />
                                <TextBlock Text="Khởi đầu" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            </Grid>

                            <!-- Chủ đề -->
                            <TextBlock Text="Chủ đề / Ý tưởng video (*):" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" MaxHeight="100" 
                                     Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" 
                                     BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Padding="8" FontSize="12.5" Margin="0,0,0,10" />

                            <!-- Tùy chọn phong cách & tỷ lệ -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Phong cách ảnh:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableStyles}" SelectedItem="{Binding SelectedStyle}" DisplayMemberPath="Title"
                                              Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" Padding="6,4" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tỷ lệ khung hình:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableAspectRatios}" SelectedItem="{Binding SelectedAspectRatioDisplay}" 
                                              Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" Padding="6,4" />
                                </StackPanel>
                            </Grid>

                            <!-- Giọng đọc & Tông điệu -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Giọng thuyết minh:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableVoices}" SelectedItem="{Binding SelectedVoice}" 
                                              Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" Padding="6,4" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tông giọng kịch bản:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding AvailableTones}" SelectedItem="{Binding SelectedTone}" 
                                              Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" Padding="6,4" />
                                </StackPanel>
                            </Grid>

                            <!-- Nhạc nền BGM & Phụ đề -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" Content="Nhạc nền" IsChecked="{Binding EnableBgm}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableBgmTracks}" SelectedItem="{Binding SelectedBgmTrack}" DisplayMemberPath="Title" 
                                          IsEnabled="{Binding EnableBgm}" Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" Padding="4" Margin="0,0,10,0" />
                                <CheckBox Grid.Column="2" Content="Phụ đề Karaoke" IsChecked="{Binding EnableSubtitles}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                            </Grid>

                            <!-- Gemini API Key Input -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" 
                                         BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="6,4" FontSize="11" Margin="0,0,6,0" />
                                <Button Grid.Column="1" Content="Lưu Key" Command="{Binding SaveApiKeyCommand}" 
                                        Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" Padding="8,4" FontSize="11" />
                            </Grid>

                            <!-- ACTION BƯỚC 2: AI LẬP DÀN Ý -->
                            <Button Content="🤖 AI LẬP DÀN Ý (BƯỚC 2)" Command="{Binding GenerateOutlineCommand}" 
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Background="{StaticResource AccentBlue}" Foreground="#181825" FontWeight="Bold" FontSize="13" 
                                    Padding="0,10" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <!-- CARD BƯỚC 2: DÀN Ý VIDEO (OUTLINE) -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="BƯỚC 2: DÀN Ý NỘI DUNG" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource AccentCyan}" />
                                <Border HorizontalAlignment="Right" Background="{Binding Step2Status, Converter={StaticResource StepStatusToBrushConverter}}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding Step2Status, Converter={StaticResource StepStatusToTextConverter}}" FontSize="10.5" FontWeight="Bold" Foreground="#181825" />
                                </Border>
                            </Grid>

                            <!-- Tiêu đề dàn ý -->
                            <TextBlock Text="Tiêu đề gợi ý:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding OutlineTitle, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" 
                                     BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Padding="6" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8" />

                            <!-- Tóm tắt dàn ý -->
                            <TextBlock Text="Tóm tắt nội dung:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding OutlineSummary, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="45" MaxHeight="70" 
                                     Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" 
                                     BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Padding="6" FontSize="11.5" Margin="0,0,10,0" />

                            <!-- Các phần trong dàn ý -->
                            <TextBlock Text="Các nhịp kịch tính (Sections):" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding OutlineSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="8" Margin="0,0,0,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBox Text="{Binding Heading, UpdateSourceTrigger=PropertyChanged}" FontWeight="Bold" FontSize="11.5" 
                                                             Background="Transparent" Foreground="{StaticResource AccentYellow}" BorderThickness="0" Padding="0" />
                                                    <TextBlock Text="{Binding EstimatedSeconds, StringFormat='~{0}s'}" HorizontalAlignment="Right" FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                                                </Grid>
                                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" FontSize="11" 
                                                         Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Margin="0,3,0,0" Padding="0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Nút hành động dàn ý -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="🔄 Tạo Lại Dàn Ý" Command="{Binding GenerateOutlineCommand}" 
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                        Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                                        Padding="0,8" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" />

                                <Button Grid.Column="2" Content="✅ XÁC NHẬN DÀN Ý" Command="{Binding ConfirmOutlineCommand}" 
                                        IsEnabled="{Binding HasOutline}"
                                        Background="{StaticResource AccentGreen}" Foreground="#181825" FontWeight="Bold" 
                                        Padding="0,8" BorderThickness="0" Cursor="Hand" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ── CỘT PHẢI ── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Bước 3: Kịch bản phân cảnh -->
                    <RowDefinition Height="*" MinHeight="260" />
                    <!-- Bước 4, 5, 6, 7: Các nút sản xuất media -->
                    <RowDefinition Height="Auto" />
                    <!-- Bước 8: Kết quả hoàn thành -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CARD BƯỚC 3: KỊCH BẢN PHÂN CẢNH -->
                <Border Grid.Row="0" Background="{StaticResource BgCard}" CornerRadius="10" Padding="16" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header Bước 3 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="BƯỚC 3: KỊCH BẢN PHÂN CẢNH" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource AccentCyan}" />
                                <TextBlock Text="{Binding Scenes.Count, StringFormat=' ({0} cảnh)'}" FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Background="{Binding Step3Status, Converter={StaticResource StepStatusToBrushConverter}}" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Step3Status, Converter={StaticResource StepStatusToTextConverter}}" FontSize="10.5" FontWeight="Bold" Foreground="#181825" />
                                </Border>
                                <Button Content="📝 AI VIẾT KỊCH BẢN" Command="{Binding GenerateScriptCommand}" 
                                        IsEnabled="{Binding IsOutlineConfirmed}"
                                        Background="{StaticResource AccentBlue}" Foreground="#181825" FontWeight="Bold" FontSize="11.5" 
                                        Padding="12,5" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                        </Grid>

                        <!-- Tiêu đề kịch bản -->
                        <TextBox Grid.Row="1" Text="{Binding ScriptTitle, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{StaticResource BgDark}" Foreground="{StaticResource AccentYellow}" 
                                 BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="8,6" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,8" />

                        <!-- Danh sách phân cảnh (ScrollViewer) -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Scenes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="12" Margin="0,0,6,10" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Top bar cảnh -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SceneNumber, StringFormat='🎬 PHÂN CẢNH #{0}'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyan}" />
                                                        <TextBlock Text="{Binding DurationSeconds, StringFormat=' ({0:F1}s)'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <!-- Audio Badge -->
                                                        <Border Background="{Binding IsAudioReady, Converter={StaticResource BoolToVisConverter}}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                            <TextBlock Text="🎙️ Audio OK" FontSize="9.5" Foreground="{StaticResource AccentGreen}" />
                                                        </Border>
                                                        <!-- Image Badge -->
                                                        <Border Background="{Binding IsImageReady, Converter={StaticResource BoolToVisConverter}}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                            <TextBlock Text="🎨 Ảnh OK" FontSize="9.5" Foreground="{StaticResource AccentGreen}" />
                                                        </Border>
                                                        <!-- Xóa cảnh -->
                                                        <Button Content="✕" Command="{Binding DataContext.RemoveSceneCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                CommandParameter="{Binding}" Background="Transparent" Foreground="{StaticResource AccentRed}" 
                                                                BorderThickness="0" Padding="4,0" Cursor="Hand" ToolTip="Xóa cảnh này" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Lời thoại tiếng Việt -->
                                                <StackPanel Grid.Row="1" Margin="0,0,0,6">
                                                    <TextBlock Text="Lời đọc thuyết minh (Tiếng Việt):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding NarrationText, UpdateSourceTrigger=PropertyChanged}" 
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" 
                                                             Background="{StaticResource BgCard}" Foreground="{StaticResource TextPrimary}" 
                                                             BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="6" FontSize="11.5" />
                                                </StackPanel>

                                                <!-- Mô tả ảnh tiếng Anh -->
                                                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                                    <TextBlock Text="Mô tả hình ảnh AI (Prompt tiếng Anh):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding VisualPrompt, UpdateSourceTrigger=PropertyChanged}" 
                                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" 
                                                             Background="{StaticResource BgCard}" Foreground="#a6adc8" 
                                                             BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="6" FontSize="11" FontFamily="Consolas, Segoe UI" />
                                                </StackPanel>

                                                <!-- Buttons điều khiển con -->
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="🎧 Nghe thử giọng" Command="{Binding DataContext.PreviewSceneVoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                                                            Padding="8,3" FontSize="10.5" Margin="0,0,6,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" />
                                                    <Button Content="🎨 Tạo lại ảnh này" Command="{Binding DataContext.RegenerateSingleSceneImageCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                                                            Padding="8,3" FontSize="10.5" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Cursor="Hand" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Footer Bước 3: Thêm cảnh & Xác nhận kịch bản -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="➕ Thêm Phân Cảnh" Command="{Binding AddSceneCommand}" 
                                    Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                                    Padding="14,6" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" />

                            <Button Grid.Column="2" Content="✅ XÁC NHẬN KỊCH BẢN" Command="{Binding ConfirmScriptCommand}" 
                                    IsEnabled="{Binding HasScript}"
                                    Background="{StaticResource AccentGreen}" Foreground="#181825" FontWeight="Bold" 
                                    Padding="20,6" BorderThickness="0" Cursor="Hand" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- CARD CÁC BƯỚC SẢN XUẤT MEDIA: BƯỚC 4, 5, 6, 7 -->
                <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="10" Padding="14" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="SẢN XUẤT MEDIA &amp; DỰNG VIDEO (BƯỚC 4 → 7)" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10" />

                        <!-- 4 Hộp Sản Xuất Tuần Tự -->
                        <UniformGrid Grid.Row="1" Columns="4">
                            <!-- BƯỚC 4: GIỌNG ĐỌC -->
                            <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="BƯỚC 4" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentYellow}" />
                                        <TextBlock Text="{Binding Step4Status, Converter={StaticResource StepStatusToTextConverter}}" HorizontalAlignment="Right" FontSize="9.5" Foreground="{Binding Step4Status, Converter={StaticResource StepStatusToBrushConverter}}" />
                                    </Grid>
                                    <TextBlock Text="Tạo giọng đọc TTS" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                                    <Button Content="🎙️ Tạo Giọng Đọc" Command="{Binding GenerateVoiceCommand}" 
                                            IsEnabled="{Binding IsScriptConfirmed}"
                                            Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                                            Padding="0,6" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <!-- BƯỚC 5: HÌNH ẢNH -->
                            <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="BƯỚC 5" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentYellow}" />
                                        <TextBlock Text="{Binding Step5Status, Converter={StaticResource StepStatusToTextConverter}}" HorizontalAlignment="Right" FontSize="9.5" Foreground="{Binding Step5Status, Converter={StaticResource StepStatusToBrushConverter}}" />
                                    </Grid>
                                    <TextBlock Text="Sinh ảnh AI Imagen" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                                    <Button Content="🎨 Tạo Hình Ảnh" Command="{Binding GenerateImagesCommand}" 
                                            IsEnabled="{Binding HasScript}"
                                            Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                                            Padding="0,6" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <!-- BƯỚC 6: PHỤ ĐỀ -->
                            <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="10" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="BƯỚC 6" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentYellow}" />
                                        <TextBlock Text="{Binding Step6Status, Converter={StaticResource StepStatusToTextConverter}}" HorizontalAlignment="Right" FontSize="9.5" Foreground="{Binding Step6Status, Converter={StaticResource StepStatusToBrushConverter}}" />
                                    </Grid>
                                    <TextBlock Text="Tạo phụ đề ASS" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                                    <Button Content="💬 Tạo Phụ Đề" Command="{Binding GenerateSubtitlesCommand}" 
                                            IsEnabled="{Binding IsVoiceReady}"
                                            Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                                            Padding="0,6" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>

                            <!-- BƯỚC 7: DỰNG VIDEO MP4 -->
                            <Border Background="{StaticResource BgDark}" CornerRadius="8" Padding="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="BƯỚC 7" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentGreen}" />
                                        <TextBlock Text="{Binding Step7Status, Converter={StaticResource StepStatusToTextConverter}}" HorizontalAlignment="Right" FontSize="9.5" Foreground="{Binding Step7Status, Converter={StaticResource StepStatusToBrushConverter}}" />
                                    </Grid>
                                    <TextBlock Text="Ghép video FFmpeg" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                                    <Button Content="🎬 DỰNG VIDEO" Command="{Binding RenderVideoCommand}" 
                                            IsEnabled="{Binding IsVoiceReady}"
                                            Background="{StaticResource AccentGreen}" Foreground="#181825" 
                                            Padding="0,6" BorderThickness="0" Cursor="Hand" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- CARD BƯỚC 8: KẾT QUẢ HOÀN THÀNH (Hiện khi render xong) -->
                <Border Grid.Row="2" Background="#16382b" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="10" Padding="14" 
                        Visibility="{Binding FinalVideoPath, Converter={StaticResource StringNotEmptyToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🎉 BƯỚC 8: XUẤT VIDEO THÀNH CÔNG!" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentGreen}" />
                                <TextBlock Text="{Binding FinalVideoSizeMb, StringFormat=' • {0}'}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="{Binding FinalVideoDurationText, StringFormat=' • {0}'}" FontSize="12" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Text="{Binding FinalVideoPath}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="▶️ PHÁT VIDEO" Command="{Binding OpenVideoCommand}" 
                                    Background="{StaticResource AccentGreen}" Foreground="#181825" FontWeight="Bold" 
                                    Padding="16,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                            <Button Content="📁 Mở Thư Mục" Command="{Binding OpenProjectFolderCommand}" 
                                    Background="{StaticResource BgCardHover}" Foreground="{StaticResource TextPrimary}" 
                                    Padding="12,8" BorderBrush="{StaticResource BorderMedium}" BorderThickness="1" Cursor="Hand" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!--  BOTTOM STATUS & PROGRESS BAR                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource BgCard}" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}">
                    <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="10" Foreground="{StaticResource AccentCyan}" Background="{StaticResource BgDark}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
