<Window x:Class="VideoAutoWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:VideoAutoWpf.ViewModels"
        xmlns:components="clr-namespace:VideoAutoWpf.Components"
        mc:Ignorable="d"
        Title="VideoAuto .NET - Tạo Video Tự Động Hóa (Google Cloud TTS &amp; Imagen 3)" 
        Height="860" Width="1320" 
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 0: Header Component -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Content Component (Scenes + Config) -->
            <RowDefinition Height="*" />
            <!-- 2: Spacing -->
            <RowDefinition Height="12" />
            <!-- 3: Progress & Log Console Component -->
            <RowDefinition Height="190" MinHeight="110" />
        </Grid.RowDefinitions>

        <!-- HEADER COMPONENT -->
        <components:AppHeaderControl Grid.Row="0" Margin="0,0,0,14" />

        <!-- MAIN CONTENT (2 Columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Quản lý phân cảnh (66%) -->
                <ColumnDefinition Width="66*" MinWidth="540" />
                <!-- Cột phải: Cấu hình video (34%) -->
                <ColumnDefinition Width="34*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <!-- SCENE LIST COMPONENT -->
            <components:SceneListControl Grid.Column="0" Margin="0,0,10,0" />

            <!-- VIDEO CONFIG COMPONENT -->
            <components:VideoConfigControl Grid.Column="1" Margin="10,0,0,0" />
        </Grid>

        <!-- PROGRESS & LOG CONSOLE COMPONENT -->
        <components:ConsoleLogControl Grid.Row="3" />
    </Grid>
</Window>
