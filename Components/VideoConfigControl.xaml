<UserControl x:Class="VideoAutoWpf.Components.VideoConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="400" d:DesignHeight="600">
    <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Cấu Hình Đầu Ra" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                <!-- TỶ LỆ KHUNG HÌNH (ASPECT RATIO) -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Tỷ Lệ Khung Hình" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 9:16 -->
                            <RadioButton Grid.Column="0" Content="9:16 (Dọc)" GroupName="RatioGroup"
                                         IsChecked="{Binding AspectRatio, Converter={StaticResource RatioMatchConverter}, ConverterParameter='9:16'}"
                                         Foreground="{StaticResource TextPrimary}" FontSize="11" Cursor="Hand"/>
                            <!-- 16:9 -->
                            <RadioButton Grid.Column="1" Content="16:9 (Ngang)" GroupName="RatioGroup"
                                         IsChecked="{Binding AspectRatio, Converter={StaticResource RatioMatchConverter}, ConverterParameter='16:9'}"
                                         Foreground="{StaticResource TextPrimary}" FontSize="11" Cursor="Hand"/>
                            <!-- 1:1 -->
                            <RadioButton Grid.Column="2" Content="1:1 (Vuông)" GroupName="RatioGroup"
                                         IsChecked="{Binding AspectRatio, Converter={StaticResource RatioMatchConverter}, ConverterParameter='1:1'}"
                                         Foreground="{StaticResource TextPrimary}" FontSize="11" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>



                <!-- ĐẦU RA (OUTPUT DIRECTORY & FILENAME) -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Xuất File Video" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>

                        <!-- Output directory -->
                        <TextBlock Text="Thư mục lưu:" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding OutputDirectory}" FontSize="11"
                                     Background="#26273b" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}"
                                     Padding="6,4" VerticalContentAlignment="Center">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></TextBox.Resources>
                            </TextBox>
                            <Button Grid.Column="1" Content="Duyệt..." Command="{Binding BrowseOutputDirCommand}"
                                    Padding="10,4" Margin="6,0,0,0" />
                        </Grid>

                        <!-- Output file name -->
                        <TextBlock Text="Tên file hoàn chỉnh (.mp4):" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding OutputFileName, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                 Background="#26273b" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource BorderDark}"
                                 Padding="6,4" VerticalContentAlignment="Center">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Border>


                <!-- ƯỚC TÍNH CHI PHÍ API (GOOGLE CLOUD) -->
                <Border Background="#1b1c2e" CornerRadius="8" Padding="10" BorderBrush="#363854" BorderThickness="1" Margin="0,0,0,12"
                        ToolTip="{Binding EstimatedCostTooltip}">
                    <StackPanel>
                        <!-- Header & Tổng chi phí -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💰 Ước Tính Chi Phí:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <Border Background="#2a2542" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Google Cloud" FontSize="9" FontWeight="Bold" Foreground="#a78bfa"/>
                                </Border>
                            </StackPanel>

                            <!-- Tổng tiền nổi bật -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EstimatedTotalCostDisplay}" FontSize="13" FontWeight="Bold" 
                                           Foreground="{StaticResource AccentYellow}"/>
                                <TextBlock Text="{Binding EstimatedTotalCostVndDisplay}" FontSize="10.5" FontWeight="SemiBold" 
                                           Foreground="{StaticResource AccentCyan}" Margin="4,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                        </Grid>

                        <!-- Thẻ phân bổ chi tiết 2 cột -->
                        <Grid Margin="0,2,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Imagen 3 -->
                            <Border Background="#23243a" CornerRadius="5" Padding="6,4" Margin="0,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="🎨 Imagen 3 (Vẽ ảnh)" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding EstimatedImagenCostText}" FontSize="10.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Google TTS -->
                            <Border Grid.Column="1" Background="#23243a" CornerRadius="5" Padding="6,4" Margin="3,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="🎙️ Cloud TTS (Giọng nói)" FontSize="9.5" Foreground="{StaticResource TextMuted}"/>
                                    <TextBlock Text="{Binding EstimatedTtsCostText}" FontSize="10.5" FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Ghi chú giải thích -->
                        <Grid Margin="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡 ~$0.03/ảnh • Free 1M ký tự TTS/tháng" FontSize="9" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="FFmpeg &amp; BGM: 0đ" FontSize="9" FontWeight="SemiBold" Foreground="#a6e3a1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ACTION BUTTONS -->
                <StackPanel Orientation="Vertical">
                    <!-- KHỐI SERIES MODE (Khi đang làm việc với Series) -->
                    <Border Visibility="{Binding IsSeriesMode, Converter={StaticResource BoolToVisConverter}}"
                            Background="#1e1e2e" BorderBrush="#7287fd" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🎬 XUẤT CHUỖI SERIES" FontSize="12.5" FontWeight="Bold" Foreground="#cdd6f4"/>
                                    <TextBlock Text="{Binding CurrentSeries.SeriesTitle}" FontSize="11" Foreground="#89b4fa" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#313244" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSeries.Episodes.Count, StringFormat='{}{0} tập'}" FontSize="11" FontWeight="Bold" Foreground="#a6e3a1"/>
                                </Border>
                            </Grid>

                            <!-- Tiến độ Batch Render nếu đang chạy -->
                            <StackPanel Visibility="{Binding IsBatchRenderingSeries, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,8">
                                <ProgressBar Value="{Binding BatchRenderProgress}" Maximum="100" Height="8" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding BatchRenderStatusText}" FontSize="10.5" Foreground="#f9e2af" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Nút Xuất toàn bộ Series -->
                            <Button Content="🎬 XUẤT TOÀN BỘ SERIES (BATCH)" Command="{Binding StartBatchRenderSeriesCommand}"
                                    IsEnabled="{Binding IsRendering, Converter={StaticResource InverseBoolConverter}}"
                                    Background="#7287fd" Foreground="White" BorderThickness="0" FontWeight="Bold"
                                    FontSize="12.5" Height="42" Margin="0,0,0,6"
                                    ToolTip="Tự động duyệt qua từng tập, gọi AI tạo ảnh, lồng tiếng và render video trọn gói" />

                            <!-- Nút Render riêng tập đang chọn -->
                            <Button Content="▶️ Chỉ Xuất Tập Này" Command="{Binding StartRenderCommand}"
                                    IsEnabled="{Binding IsRendering, Converter={StaticResource InverseBoolConverter}}"
                                    Background="#313244" Foreground="#cdd6f4" BorderBrush="#45475a" BorderThickness="1"
                                    FontSize="11.5" Height="34" Margin="0,0,0,4"
                                    ToolTip="Chỉ render video cho riêng tập phim đang chọn trên màn hình" />

                            <!-- Nút Dừng Render Series -->
                            <Button Content="⛔ Dừng / Hủy Render" Command="{Binding CancelRenderCommand}"
                                    Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisConverter}}"
                                    Style="{StaticResource BtnDanger}"
                                    FontSize="11.5" Height="32" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- KHỐI CHẾ ĐỘ THƯỜNG (Khi KHÔNG trong Series Mode) -->
                    <StackPanel Visibility="{Binding IsSeriesMode, Converter={StaticResource InverseBoolToVisConverter}}">
                        <!-- Nút Render lớn 1-Click -->
                        <Button Content="🚀 BẮT ĐẦU TẠO VIDEO (1-CLICK)" Command="{Binding StartRenderCommand}"
                                IsEnabled="{Binding IsRendering, Converter={StaticResource InverseBoolConverter}}"
                                Style="{StaticResource BtnPrimary}"
                                FontSize="13" Height="46" Margin="0,0,0,8"
                                ToolTip="Tự động gọi Google TTS cho audio thiếu + Imagen 3 cho ảnh thiếu + FFmpeg ghép video" />

                        <!-- Nút Hủy (Chỉ hiện khi đang render) -->
                        <Button Content="⛔ Dừng / Hủy Render" Command="{Binding CancelRenderCommand}"
                                Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisConverter}}"
                                Style="{StaticResource BtnDanger}"
                                FontSize="12" Height="36" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
