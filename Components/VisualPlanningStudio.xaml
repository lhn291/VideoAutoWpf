<UserControl x:Class="VideoAutoWpf.Components.VisualPlanningStudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VideoAutoWpf.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#0D1117">

    <UserControl.Resources>
        <!-- ── STYLES ── -->
        <Style x:Key="StudioTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" 
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF4E3A"/>
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AssetCard" TargetType="Border">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF4E3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E03020"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3D3D3D"/>
                                <Setter Property="Foreground" Value="#6E7681"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApprovedBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A4731"/>
            <Setter Property="Foreground" Value="#56D364"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F5235"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header + Tabs -->
            <RowDefinition Height="Auto"/>  <!-- Progress bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Approval Gate footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- HEADER & TAB BAR -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title row -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎨" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Visual Planning Studio" FontSize="18" FontWeight="Bold"
                               Foreground="#F0F6FC" VerticalAlignment="Center"/>
                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="12,0,0,0">
                        <TextBlock FontSize="11" Foreground="#8B949E">
                            <Run Text="{Binding ApprovedCharacterCount}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalCharacterCount}"/>
                            <Run Text=" nhân vật · "/>
                            <Run Text="{Binding ApprovedLocationCount}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalLocationCount}"/>
                            <Run Text=" địa điểm"/>
                        </TextBlock>
                    </Border>

                    <!-- Busy indicator -->
                    <Border Background="#0D419D" BorderBrush="#1F6FEB" BorderThickness="1"
                            CornerRadius="4" Padding="8,3" Margin="8,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏳ " FontSize="11" Foreground="#79C0FF"/>
                            <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#79C0FF"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab bar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <RadioButton Style="{StaticResource StudioTabButton}" GroupName="StudioTabs"
                                 IsChecked="{Binding ActiveTabIndex, Converter={StaticResource BoolToVis}, ConverterParameter=0}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 Nhân Vật"/>
                            <Border Background="#21262D" CornerRadius="8" Padding="5,1" Margin="5,0,0,0">
                                <TextBlock FontSize="10" Foreground="#58A6FF">
                                    <Run Text="{Binding ApprovedCharacterCount}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding TotalCharacterCount}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource StudioTabButton}" GroupName="StudioTabs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏙️ Địa Điểm"/>
                            <Border Background="#21262D" CornerRadius="8" Padding="5,1" Margin="5,0,0,0">
                                <TextBlock FontSize="10" Foreground="#58A6FF">
                                    <Run Text="{Binding ApprovedLocationCount}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding TotalLocationCount}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource StudioTabButton}" GroupName="StudioTabs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎬 Phong Cách"/>
                            <TextBlock Text=" ✅" FontSize="11" Foreground="#56D364"
                                       Visibility="{Binding StyleBible.IsApproved, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource StudioTabButton}" GroupName="StudioTabs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼️ Scene Preview"/>
                            <Border Background="#21262D" CornerRadius="8" Padding="5,1" Margin="5,0,0,0">
                                <TextBlock FontSize="10" Foreground="#58A6FF">
                                    <Run Text="{Binding ApprovedPreviewCount}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding TotalPreviewCount}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- PROGRESS BAR (hiện khi đang tạo ảnh) -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <ProgressBar Grid.Row="1" Height="3" Value="{Binding ProgressValue}"
                     Maximum="100" Background="#21262D" Foreground="#FF4E3A"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT AREA -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- TAB 0: CHARACTERS -->
            <Grid Visibility="{Binding IsChecked, ElementName=tab0, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Character List -->
                <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <!-- Action bar -->
                        <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🖼️ Tạo tất cả" Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding GenerateAllCharacterPortraitsCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Tạo ảnh chân dung cho tất cả nhân vật"/>
                                <Button Content="⛔" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"
                                        Command="{Binding CancelCurrentOperationCommand}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Hủy tạo ảnh"/>
                            </StackPanel>
                        </Border>

                        <!-- Character cards -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Characters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MouseLeftButtonUp="CharacterCard_Click"
                                                Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource AssetCard}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#2EA043"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ApprovalStatus}" Value="NeedsReview">
                                                            <Setter Property="BorderBrush" Value="#D29922"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ApprovalStatus}" Value="Error">
                                                            <Setter Property="BorderBrush" Value="#DA3633"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid Margin="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Thumbnail -->
                                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="4"
                                                        Background="#21262D" ClipToBounds="True">
                                                    <Image Source="{Binding DisplayImagePath}" Stretch="UniformToFill"/>
                                                </Border>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#F0F6FC" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Role}" FontSize="11" Foreground="#8B949E"
                                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#21262D"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                                            <Setter Property="Background" Value="#1A4731"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                       Foreground="#8B949E">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                                                <Setter Property="Foreground" Value="#56D364"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Text="{Binding SceneCountText}" FontSize="10"
                                                                   Foreground="#58A6FF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Character Detail Panel -->
                <Border Grid.Column="1" Background="#0D1117">
                    <Grid DataContext="{Binding SelectedCharacter}">
                        <!-- Placeholder khi chưa chọn -->
                        <TextBlock Text="← Chọn một nhân vật để xem và tạo ảnh"
                                   FontSize="14" Foreground="#484F58" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.HasSelectedCharacter, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                Converter={StaticResource BoolToVis}}"/>

                        <!-- Detail khi đã chọn -->
                        <ScrollViewer Visibility="{Binding DataContext.HasSelectedCharacter, RelativeSource={RelativeSource AncestorType=UserControl},
                                                  Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="20">
                                <!-- Name & Status -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                                   Foreground="#F0F6FC"/>
                                        <TextBlock Text="{Binding DisplaySummary}" FontSize="12"
                                                   Foreground="#8B949E" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#21262D"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                        <Setter Property="Background" Value="#1A4731"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#8B949E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                                            <Setter Property="Foreground" Value="#56D364"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="📸 Tạo Chân Dung" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding DataContext.GenerateCharacterPortraitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="🧍 Tạo Toàn Thân" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.GenerateCharacterFullBodyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="✅ Duyệt Ảnh" Style="{StaticResource ApprovedBtn}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ApproveCharacterPortraitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanApprove}"/>
                                    <Button Content="🔓 Mở Khóa" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.UnlockCharacterProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- Portrait Image Preview -->
                                <TextBlock Text="📸 Ảnh Chân Dung" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,20,0,8"/>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="400" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Chưa có ảnh — Bấm 'Tạo Chân Dung' để tạo"
                                                   FontSize="13" Foreground="#484F58"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="20"/>
                                        <Image Source="{Binding PortraitAsset.DisplayImagePath}"
                                               Stretch="Uniform" MaxHeight="400"/>
                                    </Grid>
                                </Border>

                                <!-- Version info -->
                                <TextBlock FontSize="11" Foreground="#484F58" Margin="0,4,0,0">
                                    <Run Text="Phiên bản: v"/>
                                    <Run Text="{Binding PortraitAsset.VersionCount}"/>
                                    <Run Text=" · Phiên bản được duyệt: "/>
                                    <Run Text="{Binding PortraitAsset.ApprovedVersionIndex}"/>
                                </TextBlock>

                                <!-- Full Body Preview -->
                                <TextBlock Text="🧍 Ảnh Toàn Thân" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,16,0,8"/>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="300" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Chưa có ảnh toàn thân"
                                                   FontSize="13" Foreground="#484F58"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding FullBodyAsset.DisplayImagePath}"
                                               Stretch="Uniform" MaxHeight="300"/>
                                    </Grid>
                                </Border>

                                <!-- Character description (readonly khi locked) -->
                                <TextBlock Text="📋 Mô Tả Nhân Vật" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,16,0,8"/>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Khuôn mặt:" FontSize="11"
                                               Foreground="#6E7681" VerticalAlignment="Top" Margin="0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FaceDescription, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                             BorderBrush="#30363D" BorderThickness="1" Padding="6,4"
                                             TextWrapping="Wrap" AcceptsReturn="False" Margin="0,2"
                                             IsReadOnly="{Binding IsLocked}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Trang phục:" FontSize="11"
                                               Foreground="#6E7681" VerticalAlignment="Top" Margin="0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutfitVn, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                             BorderBrush="#30363D" BorderThickness="1" Padding="6,4"
                                             TextWrapping="Wrap" AcceptsReturn="False" Margin="0,2"
                                             IsReadOnly="{Binding IsLocked}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Visual Prompt:" FontSize="11"
                                               Foreground="#6E7681" VerticalAlignment="Top" Margin="0,4"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VisualPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                             BorderBrush="#30363D" BorderThickness="1" Padding="6,4"
                                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,2"
                                             IsReadOnly="{Binding IsLocked}"/>
                                </Grid>

                                <!-- Locked warning -->
                                <Border Background="#1A1A2E" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="11" Foreground="#8B949E" TextWrapping="Wrap">
                                        🔒 Hồ sơ đã khóa. Bấm 'Mở Khóa' để chỉnh sửa lại — các scene phụ thuộc sẽ được đánh dấu cần xem lại.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 1: LOCATIONS -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Location List -->
                <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="10,8">
                            <Button Content="🏙️ Tạo tất cả địa điểm" Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding GenerateAllLocationsCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Locations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8,4" Background="#161B22" BorderBrush="#30363D"
                                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                                Cursor="Hand" MouseLeftButtonUp="LocationCard_Click" Tag="{Binding}">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#F0F6FC" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="#8B949E" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <TextBlock Text="{Binding FunctionOrPurpose}" FontSize="11"
                                                           Foreground="#8B949E" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="#58A6FF" Margin="0,2,0,0">
                                                    <Run Text="{Binding SceneCountText}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Location Detail -->
                <Border Grid.Column="1" Background="#0D1117">
                    <ScrollViewer DataContext="{Binding SelectedLocation}">
                        <StackPanel Margin="20">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="#F0F6FC"/>
                            <TextBlock Text="{Binding ArchitecturalStyle}" FontSize="12" Foreground="#8B949E" Margin="0,4,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="🏙️ Tạo Ảnh Địa Điểm" Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding DataContext.GenerateLocationImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="✅ Duyệt Ảnh" Style="{StaticResource ApprovedBtn}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ApproveLocationImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🔓 Mở Khóa" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.UnlockLocationProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <!-- Location Image -->
                            <TextBlock Text="🏙️ Ảnh Địa Điểm" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#8B949E" Margin="0,20,0,8"/>
                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="8" MaxHeight="350" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="Chưa có ảnh — Bấm 'Tạo Ảnh Địa Điểm' để tạo"
                                               FontSize="13" Foreground="#484F58"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                                    <Image Source="{Binding LocationAsset.DisplayImagePath}"
                                           Stretch="Uniform" MaxHeight="350"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="📋 Thông Tin Địa Điểm" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#8B949E" Margin="0,16,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nội/Ngoại thất:" FontSize="11" Foreground="#6E7681" Margin="0,4"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InteriorOrExterior}" FontSize="11"
                                         Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                         Padding="6,4" Margin="0,2" IsReadOnly="{Binding IsLocked}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Nội thất:" FontSize="11" Foreground="#6E7681" Margin="0,4"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InteriorDetails}" FontSize="11"
                                         Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                         Padding="6,4" TextWrapping="Wrap" MinHeight="40" Margin="0,2"
                                         IsReadOnly="{Binding IsLocked}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Visual Prompt:" FontSize="11" Foreground="#6E7681" Margin="0,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VisualPrompt}" FontSize="11"
                                         Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                         Padding="6,4" TextWrapping="Wrap" MinHeight="60" Margin="0,2"
                                         IsReadOnly="{Binding IsLocked}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- TAB 2: VISUAL STYLE -->
            <ScrollViewer>
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="24" MaxWidth="800">
                    <TextBlock Text="🎬 Visual Style Bible" FontSize="18" FontWeight="Bold"
                               Foreground="#F0F6FC" Margin="0,0,0,4"/>
                    <TextBlock Text="Mọi ảnh scene sẽ tuân theo phong cách này. Tạo ảnh mẫu và duyệt trước khi sản xuất."
                               FontSize="12" Foreground="#8B949E" Margin="0,0,0,20" TextWrapping="Wrap"/>

                    <!-- Style fields -->
                    <Grid DataContext="{Binding StyleBible}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên phong cách:" FontSize="12" Foreground="#6E7681" Margin="0,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StyleDisplayName}" FontSize="12"
                                 Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                 Padding="8,6" Margin="0,4"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mô tả:" FontSize="12" Foreground="#6E7681" Margin="0,8"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StyleDescription}" FontSize="12"
                                 Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                 Padding="8,6" TextWrapping="Wrap" MinHeight="50" Margin="0,4"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Bảng màu:" FontSize="12" Foreground="#6E7681" Margin="0,8"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ColorPalette}" FontSize="12"
                                 Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                 Padding="8,6" Margin="0,4"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ánh sáng:" FontSize="12" Foreground="#6E7681" Margin="0,8"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LightingStyle}" FontSize="12"
                                 Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                 Padding="8,6" Margin="0,4"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Camera/DoF:" FontSize="12" Foreground="#6E7681" Margin="0,8"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DepthOfField}" FontSize="12"
                                 Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                 Padding="8,6" Margin="0,4"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tỷ lệ ảnh:" FontSize="12" Foreground="#6E7681" Margin="0,8"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding AspectRatio}" FontSize="12"
                                 Foreground="#C9D1D9" Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                                 Padding="8,6" Margin="0,4" IsReadOnly="True"/>
                    </Grid>

                    <!-- Style sample buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="🎬 Tạo Ảnh Mẫu Phong Cách" Style="{StaticResource PrimaryBtn}"
                                Command="{Binding GenerateStyleSampleCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="✅ Duyệt Phong Cách" Style="{StaticResource ApprovedBtn}" Margin="8,0,0,0"
                                Command="{Binding ApproveStyleBibleCommand}"/>
                    </StackPanel>

                    <!-- Style sample preview -->
                    <TextBlock Text="🖼️ Ảnh Mẫu Phong Cách" FontSize="13" FontWeight="SemiBold"
                               Foreground="#8B949E" Margin="0,20,0,8"/>
                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="8" MaxHeight="400" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="Chưa có ảnh mẫu — Bấm 'Tạo Ảnh Mẫu Phong Cách' để tạo"
                                       FontSize="13" Foreground="#484F58"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                            <Image Source="{Binding StyleBible.SampleAsset.DisplayImagePath}"
                                   Stretch="Uniform" MaxHeight="400"/>
                        </Grid>
                    </Border>

                    <Border Background="#1A4731" BorderBrush="#2EA043" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,12,0,0"
                            Visibility="{Binding StyleBible.IsApproved, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✅ Visual Style Bible đã được duyệt — mọi scene sẽ sử dụng phong cách này."
                                   FontSize="12" Foreground="#56D364" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: SCENE PREVIEWS -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Preview list -->
                <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="10,8">
                            <StackPanel>
                                <Button Content="🖼️ Tạo tất cả scene preview" Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding GenerateAllPreviewsCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Cần duyệt Visual Style Bible trước" FontSize="10"
                                           Foreground="#8B949E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ScenePreviews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="8,4" Background="#161B22" BorderBrush="#30363D"
                                                BorderThickness="1" CornerRadius="8" Padding="12,10"
                                                Cursor="Hand" MouseLeftButtonUp="PreviewCard_Click" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="4"
                                                        Background="#21262D" ClipToBounds="True">
                                                    <Image Source="{Binding DisplayImagePath}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#F0F6FC"/>
                                                    <TextBlock Text="{Binding PreviewReason}" FontSize="10"
                                                               Foreground="#8B949E" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                               Foreground="#8B949E" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Preview detail -->
                <Border Grid.Column="1" Background="#0D1117">
                    <ScrollViewer DataContext="{Binding SelectedPreview}">
                        <StackPanel Margin="20">
                            <TextBlock Text="{Binding DisplayTitle}" FontSize="18" FontWeight="Bold" Foreground="#F0F6FC"/>
                            <TextBlock Text="{Binding PreviewReason}" FontSize="12" Foreground="#58A6FF" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#8B949E" Margin="0,2,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="🖼️ Tạo Preview" Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding DataContext.GenerateScenePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="✅ Duyệt Preview" Style="{StaticResource ApprovedBtn}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.ApproveScenePreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding HasImage}"/>
                            </StackPanel>

                            <!-- Scene image -->
                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="8" Margin="0,16,0,0" MaxHeight="400" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="Chưa có ảnh preview"
                                               FontSize="13" Foreground="#484F58"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                                    <Image Source="{Binding DisplayImagePath}" Stretch="Uniform" MaxHeight="400"/>
                                </Grid>
                            </Border>

                            <!-- Scene description -->
                            <TextBlock Text="📝 Nội dung cảnh:" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#8B949E" Margin="0,16,0,4"/>
                            <TextBlock Text="{Binding SceneDescription}" FontSize="12" Foreground="#C9D1D9"
                                       TextWrapping="Wrap" Background="#161B22" Padding="10"
                                       MaxHeight="100"/>

                            <!-- Prompt (editable) -->
                            <TextBlock Text="🔧 Image Prompt:" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#8B949E" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding ImagePrompt, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                     BorderBrush="#30363D" BorderThickness="1" Padding="8,6"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"/>

                            <TextBlock FontSize="10" Foreground="#484F58" Margin="0,4,0,0">
                                <Run Text="v"/>
                                <Run Text="{Binding PromptVersion}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding PreviewAsset.VersionCount}"/>
                                <Run Text=" phiên bản ảnh"/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- APPROVAL GATE FOOTER -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ApprovalGateStatusText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#F0F6FC" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#8B949E"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="🔄 Kiểm tra lại" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                            Command="{Binding RefreshApprovalGateCommand}"/>
                    <Button Content="🚀 Xác Nhận Bắt Đầu Sản Xuất" Style="{StaticResource ApprovedBtn}"
                            Command="{Binding ConfirmStartProductionCommand}"
                            IsEnabled="{Binding IsApprovalGatePassed, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
