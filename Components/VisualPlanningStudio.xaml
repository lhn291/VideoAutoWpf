<UserControl x:Class="VideoAutoWpf.Components.VisualPlanningStudio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#0D1117">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#FF4E3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E03020"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3D3D3D"/>
                                <Setter Property="Foreground" Value="#6E7681"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#C9D1D9"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApprovedBtn" TargetType="Button">
            <Setter Property="Background" Value="#1A4731"/>
            <Setter Property="Foreground" Value="#56D364"/>
            <Setter Property="BorderBrush" Value="#2EA043"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1F5235"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#21262D"/>
                                <Setter Property="Foreground" Value="#484F58"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl style: dark theme -->
        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Top"/>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="itemBorder" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#FF4E3A"/>
                                <Setter Property="Foreground" Value="#F0F6FC"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#161B22"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Info bar -->
            <RowDefinition Height="3"/>      <!-- Progress bar -->
            <RowDefinition Height="*"/>      <!-- TabControl -->
            <RowDefinition Height="Auto"/>   <!-- Approval Gate footer -->
        </Grid.RowDefinitions>

        <!-- ══ INFO BAR ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🎨" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Visual Planning Studio" FontSize="16" FontWeight="Bold"
                           Foreground="#F0F6FC" VerticalAlignment="Center"/>

                <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1"
                        CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                    <TextBlock FontSize="11" Foreground="#8B949E" VerticalAlignment="Center">
                        <Run Text="{Binding ApprovedCharacterCount, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalCharacterCount, Mode=OneWay}"/>
                        <Run Text=" NV ·  "/>
                        <Run Text="{Binding ApprovedLocationCount, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalLocationCount, Mode=OneWay}"/>
                        <Run Text=" DD"/>
                    </TextBlock>
                </Border>

                <!-- Busy indicator -->
                <Border Background="#0D419D" BorderBrush="#1F6FEB" BorderThickness="1"
                        CornerRadius="4" Padding="8,2" Margin="8,0,0,0"
                        Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="11" Foreground="#79C0FF"/>
                </Border>

                <!-- Status text when idle -->
                <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="11" Foreground="#8B949E"
                           Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="400"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- ══ PROGRESS BAR ══════════════════════════════════════════════ -->
        <ProgressBar Grid.Row="1" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100"
                     Background="#21262D" Foreground="#FF4E3A"
                     Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>

        <!-- ══ TAB CONTROL ══════════════════════════════════════════════ -->
        <TabControl Grid.Row="2" Style="{StaticResource DarkTabControl}"
                    SelectedIndex="{Binding ActiveTabIndex}">

            <!-- ── TAB 1: NHÂN VẬT ───────────────────────────────────── -->
            <TabItem Style="{StaticResource DarkTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F464; Nhan Vat"/>
                        <Border Background="#21262D" CornerRadius="8" Padding="5,1" Margin="5,0,0,0">
                            <TextBlock FontSize="10" Foreground="#58A6FF">
                                <Run Text="{Binding ApprovedCharacterCount, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalCharacterCount, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Character List -->
                    <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D"
                                    BorderThickness="0,0,0,1" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Tao tat ca" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding GenerateAllCharacterPortraitsCommand}"
                                            ToolTip="Tao anh chan dung cho tat ca nhan vat"/>
                                    <Button Content="Huy" Style="{StaticResource SecondaryBtn}" Margin="6,0,0,0"
                                            Command="{Binding CancelCurrentOperationCommand}"
                                            Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Characters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6,4" CornerRadius="8" Padding="10"
                                                    Cursor="Hand" MouseLeftButtonUp="CharacterCard_Click" Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#161B22"/>
                                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApproved, Mode=OneWay}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2EA043"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ApprovalStatus, Mode=OneWay}" Value="NeedsReview">
                                                                <Setter Property="BorderBrush" Value="#D29922"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ApprovalStatus, Mode=OneWay}" Value="Generating">
                                                                <Setter Property="BorderBrush" Value="#1F6FEB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ApprovalStatus, Mode=OneWay}" Value="Error">
                                                                <Setter Property="BorderBrush" Value="#DA3633"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="4"
                                                            Background="#21262D" ClipToBounds="True">
                                                        <Image Source="{Binding PortraitAsset.DisplayImagePath, Mode=OneWay}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="13"
                                                                   FontWeight="SemiBold" Foreground="#F0F6FC"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Role, Mode=OneWay}" FontSize="11"
                                                                   Foreground="#8B949E" Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10" Foreground="#58A6FF" Margin="0,3,0,0">
                                                            <Run Text="{Binding StatusText, Mode=OneWay}"/>
                                                            <Run Text=" | "/>
                                                            <Run Text="{Binding SceneCountText, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Character Detail -->
                    <Border Grid.Column="1" Background="#0D1117">
                        <Grid>
                            <!-- Placeholder -->
                            <TextBlock Text="Chon mot nhan vat de xem va tao anh"
                                       FontSize="14" Foreground="#484F58"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedCharacter, Mode=OneWay}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Detail Panel -->
                            <ScrollViewer DataContext="{Binding SelectedCharacter}">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.HasSelectedCharacter, Mode=OneWay,
                                                         RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <StackPanel Margin="20">
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="20"
                                               FontWeight="Bold" Foreground="#F0F6FC"/>
                                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="12"
                                               Foreground="#8B949E" Margin="0,4,0,0"/>

                                    <!-- Action buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Tao Chan Dung" Style="{StaticResource PrimaryBtn}"
                                                Command="{Binding DataContext.GenerateCharacterPortraitCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Tao Toan Than" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.GenerateCharacterFullBodyCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Duyet Anh" Style="{StaticResource ApprovedBtn}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ApproveCharacterPortraitCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanApprove, Mode=OneWay}"/>
                                        <Button Content="Mo Khoa" Style="{StaticResource SecondaryBtn}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.UnlockCharacterProfileCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsLocked, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <!-- Portrait image -->
                                    <TextBlock Text="Anh Chan Dung" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#8B949E" Margin="0,16,0,6"/>
                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                            CornerRadius="8" MaxHeight="350" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="Chua co anh — Bam 'Tao Chan Dung'"
                                                       FontSize="13" Foreground="#484F58"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                                            <Image Source="{Binding PortraitAsset.DisplayImagePath, Mode=OneWay}"
                                                   Stretch="Uniform" MaxHeight="350"/>
                                        </Grid>
                                    </Border>

                                    <!-- Full body image -->
                                    <TextBlock Text="Anh Toan Than" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#8B949E" Margin="0,16,0,6"/>
                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                            CornerRadius="8" MaxHeight="280" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="Chua co anh toan than"
                                                       FontSize="13" Foreground="#484F58"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding FullBodyAsset.DisplayImagePath, Mode=OneWay}"
                                                   Stretch="Uniform" MaxHeight="280"/>
                                        </Grid>
                                    </Border>

                                    <!-- Description fields -->
                                    <TextBlock Text="Mo Ta Nhan Vat" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#8B949E" Margin="0,16,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Khuon mat:"
                                                   FontSize="11" Foreground="#6E7681" VerticalAlignment="Top" Margin="0,6"/>
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding FaceDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                                 BorderBrush="#30363D" BorderThickness="1" Padding="6,4"
                                                 TextWrapping="Wrap" Margin="0,2"
                                                 IsReadOnly="{Binding IsLocked, Mode=OneWay}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Trang phuc:"
                                                   FontSize="11" Foreground="#6E7681" VerticalAlignment="Top" Margin="0,6"/>
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding OutfitVn, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                                 BorderBrush="#30363D" BorderThickness="1" Padding="6,4"
                                                 TextWrapping="Wrap" Margin="0,2"
                                                 IsReadOnly="{Binding IsLocked, Mode=OneWay}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Visual Prompt:"
                                                   FontSize="11" Foreground="#6E7681" VerticalAlignment="Top" Margin="0,6"/>
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding VisualPrompt, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                                 BorderBrush="#30363D" BorderThickness="1" Padding="6,4"
                                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,2"
                                                 IsReadOnly="{Binding IsLocked, Mode=OneWay}"/>
                                    </Grid>

                                    <!-- Locked notice -->
                                    <Border Background="#1A1A2E" BorderBrush="#30363D" BorderThickness="1"
                                            CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                                            Visibility="{Binding IsLocked, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                        <TextBlock FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"
                                                   Text="Ho so da khoa. Bam 'Mo Khoa' de chinh sua lai — cac scene phu thuoc se duoc danh dau can xem lai."/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── TAB 2: ĐỊA ĐIỂM ──────────────────────────────────── -->
            <TabItem Style="{StaticResource DarkTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F3D9; Dia Diem"/>
                        <Border Background="#21262D" CornerRadius="8" Padding="5,1" Margin="5,0,0,0">
                            <TextBlock FontSize="10" Foreground="#58A6FF">
                                <Run Text="{Binding ApprovedLocationCount, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalLocationCount, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Location list -->
                    <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D"
                                    BorderThickness="0,0,0,1" Padding="10,8">
                                <Button Content="Tao tat ca dia diem" Style="{StaticResource PrimaryBtn}"
                                        Command="{Binding GenerateAllLocationsCommand}"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Locations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6,4" CornerRadius="8" Padding="12,10"
                                                    Cursor="Hand" MouseLeftButtonUp="LocationCard_Click" Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#161B22"/>
                                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApproved, Mode=OneWay}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2EA043"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="#F0F6FC"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="11"
                                                               Foreground="#8B949E" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding SceneCountText, Mode=OneWay}" FontSize="11"
                                                               Foreground="#58A6FF" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Location detail -->
                    <Border Grid.Column="1" Background="#0D1117">
                        <ScrollViewer DataContext="{Binding SelectedLocation}">
                            <StackPanel Margin="20">
                                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="20"
                                           FontWeight="Bold" Foreground="#F0F6FC"/>
                                <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="12"
                                           Foreground="#8B949E" Margin="0,4,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Tao Anh Dia Diem" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding DataContext.GenerateLocationImageCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Duyet Anh" Style="{StaticResource ApprovedBtn}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ApproveLocationImageCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasImage, Mode=OneWay}"/>
                                </StackPanel>

                                <TextBlock Text="Anh Dia Diem" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,16,0,6"/>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="350" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Chua co anh — Bam 'Tao Anh Dia Diem'"
                                                   FontSize="13" Foreground="#484F58"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                                        <Image Source="{Binding LocationAsset.DisplayImagePath, Mode=OneWay}"
                                               Stretch="Uniform" MaxHeight="350"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Thong Tin Dia Diem" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,16,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Kien truc:" FontSize="11"
                                               Foreground="#6E7681" Margin="0,6"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding ArchitecturalStyle, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                             BorderBrush="#30363D" BorderThickness="1" Padding="6,4" Margin="0,2"
                                             IsReadOnly="{Binding IsLocked, Mode=OneWay}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Noi that:" FontSize="11"
                                               Foreground="#6E7681" Margin="0,6"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding InteriorDetails, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                             BorderBrush="#30363D" BorderThickness="1" Padding="6,4"
                                             TextWrapping="Wrap" MinHeight="40" Margin="0,2"
                                             IsReadOnly="{Binding IsLocked, Mode=OneWay}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Visual Prompt:" FontSize="11"
                                               Foreground="#6E7681" Margin="0,6"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding VisualPrompt, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                             BorderBrush="#30363D" BorderThickness="1" Padding="6,4"
                                             TextWrapping="Wrap" MinHeight="60" Margin="0,2"
                                             IsReadOnly="{Binding IsLocked, Mode=OneWay}"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── TAB 3: PHONG CÁCH ─────────────────────────────────── -->
            <TabItem Style="{StaticResource DarkTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F3AC; Phong Cach"/>
                        <TextBlock Text=" OK" FontSize="11" Foreground="#56D364"
                                   Visibility="{Binding StyleBible.IsApproved, Mode=OneWay, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer>
                    <StackPanel Margin="24" MaxWidth="800">
                        <TextBlock Text="Visual Style Bible" FontSize="18" FontWeight="Bold"
                                   Foreground="#F0F6FC" Margin="0,0,0,4"/>
                        <TextBlock Text="Moi anh scene se tuan theo phong cach nay. Tao anh mau va duyet truoc khi san xuat."
                                   FontSize="12" Foreground="#8B949E" Margin="0,0,0,16" TextWrapping="Wrap"/>

                        <Grid DataContext="{Binding StyleBible}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ten phong cach:" FontSize="12"
                                       Foreground="#6E7681" Margin="0,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StyleDisplayName}"
                                     FontSize="12" Foreground="#C9D1D9" Background="#21262D"
                                     BorderBrush="#30363D" BorderThickness="1" Padding="8,6" Margin="0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bang mau:" FontSize="12"
                                       Foreground="#6E7681" Margin="0,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ColorPalette}"
                                     FontSize="12" Foreground="#C9D1D9" Background="#21262D"
                                     BorderBrush="#30363D" BorderThickness="1" Padding="8,6" Margin="0,4"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Anh sang:" FontSize="12"
                                       Foreground="#6E7681" Margin="0,8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LightingStyle}"
                                     FontSize="12" Foreground="#C9D1D9" Background="#21262D"
                                     BorderBrush="#30363D" BorderThickness="1" Padding="8,6" Margin="0,4"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Camera/DoF:" FontSize="12"
                                       Foreground="#6E7681" Margin="0,8"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DepthOfField}"
                                     FontSize="12" Foreground="#C9D1D9" Background="#21262D"
                                     BorderBrush="#30363D" BorderThickness="1" Padding="8,6" Margin="0,4"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Phong cach them:" FontSize="12"
                                       Foreground="#6E7681" Margin="0,8"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StyleDescription}"
                                     FontSize="12" Foreground="#C9D1D9" Background="#21262D"
                                     BorderBrush="#30363D" BorderThickness="1" Padding="8,6"
                                     TextWrapping="Wrap" MinHeight="50" Margin="0,4"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Tao Anh Mau Phong Cach" Style="{StaticResource PrimaryBtn}"
                                    Command="{Binding GenerateStyleSampleCommand}"/>
                            <Button Content="Duyet Phong Cach" Style="{StaticResource ApprovedBtn}" Margin="8,0,0,0"
                                    Command="{Binding ApproveStyleBibleCommand}"/>
                        </StackPanel>

                        <TextBlock Text="Anh Mau Phong Cach" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#8B949E" Margin="0,16,0,6"/>
                        <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                CornerRadius="8" MaxHeight="380" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="Chua co anh mau — Bam 'Tao Anh Mau Phong Cach'"
                                           FontSize="13" Foreground="#484F58"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                                <Image Source="{Binding StyleBible.SampleAsset.DisplayImagePath, Mode=OneWay}"
                                       Stretch="Uniform" MaxHeight="380"/>
                            </Grid>
                        </Border>

                        <Border Background="#1A4731" BorderBrush="#2EA043" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                                Visibility="{Binding StyleBible.IsApproved, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Visual Style Bible da duoc duyet — moi scene se su dung phong cach nay."
                                       FontSize="12" Foreground="#56D364" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 4: SCENE PREVIEW ──────────────────────────────── -->
            <TabItem Style="{StaticResource DarkTabItem}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F5BC; Scene Preview"/>
                        <Border Background="#21262D" CornerRadius="8" Padding="5,1" Margin="5,0,0,0">
                            <TextBlock FontSize="10" Foreground="#58A6FF">
                                <Run Text="{Binding ApprovedPreviewCount, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalPreviewCount, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preview list -->
                    <Border Grid.Column="0" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D"
                                    BorderThickness="0,0,0,1" Padding="10,8">
                                <StackPanel>
                                    <Button Content="Tao tat ca scene preview" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding GenerateAllPreviewsCommand}"/>
                                    <TextBlock Text="Can duyet Style Bible truoc" FontSize="10"
                                               Foreground="#8B949E" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ScenePreviews}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6,4" CornerRadius="8" Padding="10"
                                                    Cursor="Hand" MouseLeftButtonUp="PreviewCard_Click" Tag="{Binding}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#161B22"/>
                                                        <Setter Property="BorderBrush" Value="#30363D"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApproved, Mode=OneWay}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#2EA043"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="56"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="4"
                                                            Background="#21262D" ClipToBounds="True">
                                                        <Image Source="{Binding DisplayImagePath, Mode=OneWay}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayTitle, Mode=OneWay}"
                                                                   FontSize="12" FontWeight="SemiBold" Foreground="#F0F6FC"/>
                                                        <TextBlock Text="{Binding PreviewReason, Mode=OneWay}"
                                                                   FontSize="10" Foreground="#8B949E"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                                   FontSize="10" Foreground="#58A6FF" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Preview detail -->
                    <Border Grid.Column="1" Background="#0D1117">
                        <ScrollViewer DataContext="{Binding SelectedPreview}">
                            <StackPanel Margin="20">
                                <TextBlock Text="{Binding DisplayTitle, Mode=OneWay}" FontSize="18"
                                           FontWeight="Bold" Foreground="#F0F6FC"/>
                                <TextBlock Text="{Binding PreviewReason, Mode=OneWay}" FontSize="12"
                                           Foreground="#58A6FF" Margin="0,4,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Tao Preview" Style="{StaticResource PrimaryBtn}"
                                            Command="{Binding DataContext.GenerateScenePreviewCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Duyet Preview" Style="{StaticResource ApprovedBtn}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ApproveScenePreviewCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding HasImage, Mode=OneWay}"/>
                                </StackPanel>

                                <TextBlock Text="Anh Preview" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,16,0,6"/>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="380" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Chua co anh preview"
                                                   FontSize="13" Foreground="#484F58"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                                        <Image Source="{Binding DisplayImagePath, Mode=OneWay}"
                                               Stretch="Uniform" MaxHeight="380"/>
                                    </Grid>
                                </Border>

                                <TextBlock Text="Noi dung canh:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,12,0,4"/>
                                <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                        CornerRadius="6" Padding="10" MaxHeight="100">
                                    <TextBlock Text="{Binding SceneDescription, Mode=OneWay}" FontSize="12"
                                               Foreground="#C9D1D9" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Image Prompt:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding ImagePrompt, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Foreground="#C9D1D9" Background="#21262D"
                                         BorderBrush="#30363D" BorderThickness="1" Padding="8,6"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══ APPROVAL GATE FOOTER ══════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ApprovalGateStatusText, Mode=OneWay}" FontSize="12"
                               FontWeight="SemiBold" Foreground="#F0F6FC" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontSize="11"
                               Foreground="#8B949E" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Kiem tra lai" Style="{StaticResource SecondaryBtn}" Margin="0,0,8,0"
                            Command="{Binding RefreshApprovalGateCommand}"/>
                    <Button Content="Xac Nhan Bat Dau San Xuat" Style="{StaticResource ApprovedBtn}"
                            Command="{Binding ConfirmStartProductionCommand}"
                            IsEnabled="{Binding IsApprovalGatePassed, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
