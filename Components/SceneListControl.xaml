<UserControl x:Class="VideoAutoWpf.Components.SceneListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:components="clr-namespace:VideoAutoWpf.Components"
             xmlns:models="clr-namespace:VideoAutoWpf.Models"
             mc:Ignorable="d" 
             d:DesignWidth="800" d:DesignHeight="600">
    <Border Background="{StaticResource BgCard}" CornerRadius="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header & Script Buttons -->
                <RowDefinition Height="Auto" />
                <!-- 1: Series Mode Toolbar & Episode Switcher -->
                <RowDefinition Height="Auto" />
                <!-- 2: Voice bar & Tips -->
                <RowDefinition Height="Auto" />
                <!-- 3: Scenes List -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header Actions -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kịch Bản Phân Cảnh" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Border Background="#313244" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Scenes.Count, StringFormat='{}{0} cảnh'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                    </Border>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Nút mở Popup Tạo Series Nhiều Tập -->
                    <Button Content="📺 Tạo Series (Nhiều Tập)" Command="{Binding OpenSeriesCreatorCommand}" 
                            Background="#7287fd" Foreground="White" BorderThickness="0" FontWeight="Bold"
                            Padding="12,6" Margin="0,0,6,0"
                            ToolTip="Tạo chuỗi video dài nhiều tập có cốt truyện liền mạch, Character Bible và kết thúc lôi cuốn (Cliffhanger)" />

                    <!-- Nút mở Popup Soạn & Nạp Kịch Bản AI -->
                    <Button Content="✨ Soạn &amp; Nạp Kịch Bản" Command="{Binding OpenScriptGeneratorCommand}" 
                            Style="{StaticResource BtnPrimary}"
                            Padding="12,6" Margin="0,0,6,0"
                            ToolTip="Mở cửa sổ soạn kịch bản tự động bằng Gemini AI hoặc nạp file/dán JSON" />

                    <!-- Nút Lưu JSON -->
                    <Button Content="💾 Lưu JSON" Command="{Binding SaveScriptJsonCommand}" 
                            Padding="10,6" Margin="0,0,8,0" 
                            ToolTip="Lưu kịch bản hiện tại ra file JSON" />

                    <!-- Nút Thêm Cảnh -->
                    <Button Content="+ Thêm Cảnh" Command="{Binding AddSceneCommand}" 
                            Style="{StaticResource BtnPrimary}"
                            Padding="10,6" Margin="0,0,4,0" />

                    <!-- Nút Lên / Xuống -->
                    <Button Content="▲" ToolTip="Di chuyển lên" Command="{Binding MoveUpCommand}"
                            Width="28" Margin="0,0,3,0" Padding="0" />
                    <Button Content="▼" ToolTip="Di chuyển xuống" Command="{Binding MoveDownCommand}"
                            Width="28" Margin="0,0,6,0" Padding="0" />

                    <!-- Nút Xóa Hết -->
                    <Button Content="Xóa Hết" ToolTip="Xóa tất cả phân cảnh" Command="{Binding ClearScenesCommand}"
                            Style="{StaticResource BtnDanger}"
                            Padding="10,6" />
                </StackPanel>
            </Grid>

            <!-- Row 1: Series Mode Toolbar & Episode Switcher (Chỉ hiện khi IsSeriesMode = true) -->
            <Border Grid.Row="1" Margin="0,0,0,10" Background="#181825" BorderBrush="#7287fd" BorderThickness="1.5" CornerRadius="8" Padding="12,8"
                    Visibility="{Binding IsSeriesMode, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top info row in Series Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#7287fd" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock Text="SERIES" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentSeries.SeriesTitle}" FontSize="13" FontWeight="Bold" Foreground="#cdd6f4" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentSeries.Episodes.Count, StringFormat=' ({0} tập)'}" FontSize="12" Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="💾 Lưu Series" Command="{Binding SaveSeriesProjectCommand}"
                                    Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                    ToolTip="Lưu cấu hình toàn bộ các tập Series thành file .series.json"/>
                            <Button Content="📂 Mở Series" Command="{Binding LoadSeriesProjectFromFileCommand}"
                                    Padding="8,4" Margin="0,0,6,0" FontSize="11"
                                    ToolTip="Mở dự án chuỗi video từ file .series.json"/>
                            <Button Content="✕ Thoát Series" Command="{Binding ExitSeriesModeCommand}"
                                    Style="{StaticResource BtnDanger}"
                                    Padding="8,4" FontSize="11"
                                    ToolTip="Thoát khỏi chế độ Series và trở về làm việc với video đơn lẻ"/>
                        </StackPanel>
                    </Grid>

                    <!-- Episodes Selector Chips -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding CurrentSeries.Episodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectEpisodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="{Binding ChipBackground}"
                                                BorderBrush="{Binding ChipBorder}"
                                                BorderThickness="1.5"
                                                Margin="0,0,6,0" Padding="10,6"
                                                Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.ToolTip>
                                                <ToolTip Background="#181825" BorderBrush="#313244">
                                                    <StackPanel MaxWidth="320">
                                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="#89b4fa" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding EpisodeHook, StringFormat='🎯 Mở đầu: {0}'}" FontSize="11" Foreground="#cdd6f4" TextWrapping="Wrap" Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding Cliffhanger, StringFormat='⚡ Kết thúc: {0}'}" FontSize="11" Foreground="#f9e2af" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding Scenes.Count, StringFormat='📊 Số cảnh: {0}'}" FontSize="10.5" Foreground="#6c7086"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Button.ToolTip>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadgeIcon}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="11.5" FontWeight="SemiBold" 
                                                           Foreground="{Binding ChipForeground}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Button Thêm tập mới -->
                            <Button Content="➕ Thêm Tập" Command="{Binding AddNewEpisodeCommand}"
                                    Background="#313244" Foreground="#89b4fa" BorderBrush="#45475a" BorderThickness="1"
                                    Padding="8,5" Margin="2,0,0,0" FontSize="11" FontWeight="SemiBold"
                                    ToolTip="Thêm một tập mới vào chuỗi series này"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Row 2: Voice Selector & Hint -->
            <Border Grid.Row="2" Margin="0,0,0,10" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎙️ Giọng đọc TTS:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AvailableVoices}" SelectedItem="{Binding SelectedVoice}" Width="160"
                                  Padding="8,5" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="📺 Đang làm việc trong Chế độ Chuỗi Series. Chuyển đổi giữa các tập ở thanh công cụ phía trên!" 
                               FontSize="11" Foreground="#b4befe" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                               Visibility="{Binding IsSeriesMode, Converter={StaticResource BoolToVisConverter}}"/>

                    <TextBlock Grid.Column="1" Text="💡 Bấm '📺 Tạo Series' để lập dàn ý nhiều tập, hoặc '✨ Soạn &amp; Nạp Kịch Bản' cho video đơn!" 
                               FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                               Visibility="{Binding IsSeriesMode, Converter={StaticResource InverseBoolToVisConverter}}"/>
                </Grid>
            </Border>

            <!-- Row 3: Scenes List -->
            <ListBox Grid.Row="3" ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,0,0,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SceneItem}">
                        <components:SceneCardControl />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
